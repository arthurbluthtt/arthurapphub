---
import type { App } from '../lib/types';
import { getCategory } from '../lib/apps';
import StatusDot from './StatusDot.astro';

interface Props {
  app: App;
}

const { app } = Astro.props;
const category = getCategory(app.category);
---

<a
  href={app.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/50 dark:backdrop-blur dark:hover:border-slate-700"
>
  <div class="flex items-start justify-between">
    <span class="text-4xl leading-none">{app.icon}</span>
    <StatusDot appId={app.id} />
  </div>
  <div class="flex-1">
    <h3 class="font-semibold text-slate-900 dark:text-slate-100">{app.name}</h3>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{app.description}</p>
  </div>
  {category && (
    <span
      class="mt-auto inline-flex w-fit rounded-full px-2 py-0.5 text-xs font-medium"
      style={`background-color: ${category.color}1a; color: ${category.color};`}
    >
      {category.label}
    </span>
  )}
</a>
