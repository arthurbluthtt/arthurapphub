---
import type { App } from '../lib/types';
import AppCard from './AppCard.astro';

interface Props {
  apps: App[];
  archived?: boolean;
}

const { apps, archived = false } = Astro.props;
---

<div data-app-grid={archived ? 'archived' : 'active'} class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
  <p
    data-app-empty
    class:list={[
      'col-span-full text-center text-slate-500 dark:text-slate-400',
      apps.length ? 'hidden' : '',
    ]}
  >
    No hay apps aquí todavía.
  </p>
  {apps.map((app) => <AppCard app={app} archived={archived} />)}
</div>
