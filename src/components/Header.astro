---
import { apps } from '../lib/apps';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="border-b border-zinc-200 transition-colors dark:border-white/10">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
      <span class="text-xl leading-none">⚡</span>
      <span class="tracking-tight">AppHub</span>
    </a>
    <div class="flex items-center gap-4">
      <span class="text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
        {apps.length} {apps.length === 1 ? 'app' : 'apps'}
      </span>
      <span
        class="hidden text-sm text-zinc-500 dark:text-zinc-500"
        data-auth-only
        data-user-display
      ></span>
      <form
        method="POST"
        action="/api/auth/logout"
        class="hidden"
        data-auth-only
      >
        <button
          type="submit"
          class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white"
          title="Cerrar sesión"
        >
          Salir
        </button>
      </form>
      <ThemeToggle />
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    try {
      const m = document.cookie.match(/(?:^|; )hub_user=([^;]+)/);
      if (!m) return;
      const username = decodeURIComponent(m[1]);
      document.querySelectorAll('[data-auth-only]').forEach((el) => el.classList.remove('hidden'));
      const display = document.querySelector('[data-user-display]');
      if (display) display.textContent = username;
    } catch {}
  })();
</script>