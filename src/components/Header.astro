---
import { apps } from '../lib/apps';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="border-b border-zinc-200 transition-colors dark:border-white/10">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
      <span class="text-xl leading-none">⚡</span>
      <span class="tracking-tight">AppHub</span>
    </a>
    <div class="flex items-center gap-4">
      <span class="text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
        {apps.length} {apps.length === 1 ? 'app' : 'apps'}
      </span>
      <ThemeToggle />
    </div>
  </div>
</header>
