---
interface Props {
  placeholder?: string;
}
const { placeholder = "Buscar..." } = Astro.props;
---

<div class="mb-4 flex items-center gap-2">
  <label class="relative flex-1">
    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400" aria-hidden="true">⌕</span>
    <input
      data-search-input
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      class="w-full rounded-lg border border-zinc-300 bg-white py-2 pl-9 pr-9 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
    />
    <button
      data-search-clear
      type="button"
      aria-label="Limpiar"
      class="absolute right-2 top-1/2 hidden -translate-y-1/2 grid h-6 w-6 place-items-center rounded-full text-zinc-400 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
    >
      ×
    </button>
  </label>
</div>
