---
---
<button
  type="button"
  class="fixed bottom-6 right-6 z-30 inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-4 py-2.5 text-sm font-medium text-zinc-900 shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl dark:border-white/10 dark:bg-zinc-800 dark:text-white"
  data-add-weapon-chip
  aria-label="Agregar arma"
>
  <span class="text-base leading-none">+</span>
  <span>Agregar arma</span>
</button>

<dialog
  class="backdrop:bg-zinc-900/60 dark:bg-zinc-950/70 m-auto max-h-[90vh] w-[min(900px,calc(100vw-2rem))] rounded-2xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-2xl dark:border-white/10 dark:bg-zinc-900 dark:text-white"
  data-add-dialog
>
  <header class="flex items-center gap-3 border-b border-zinc-200 p-4 dark:border-white/10">
    <button
      type="button"
      class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
      data-add-back
      aria-label="Volver"
      hidden
    >
      ←
    </button>
    <div class="flex-1 min-w-0">
      <h2 class="font-semibold truncate" data-add-title>Seleccioná un arma</h2>
      <p class="text-xs uppercase tracking-wider text-zinc-500" data-add-subtitle>
        Buscá por nombre
      </p>
    </div>
    <button
      type="button"
      class="grid h-8 w-8 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
      data-add-close
      aria-label="Cerrar"
    >
      ×
    </button>
  </header>

  <div class="p-4" data-add-search-view>
    <input
      type="text"
      placeholder="Buscar arma (ej. Fatebringer, Mountaintop…)"
      autocomplete="off"
      spellcheck="false"
      autocapitalize="off"
      autocorrect="off"
      class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
      data-add-input
    />
    <div
      class="mt-3 hidden cursor-pointer items-center gap-3 rounded-lg border border-emerald-500/40 bg-emerald-500/5 p-3 hover:bg-emerald-500/10"
      data-add-suggestion
      role="button"
      tabindex="0"
    >
      <img alt="" class="h-10 w-10 shrink-0 rounded bg-white object-contain p-1 dark:bg-white/[0.02]" data-add-suggestion-icon />
      <div class="min-w-0 flex-1">
        <div class="truncate font-medium" data-add-suggestion-name></div>
        <div class="text-xs uppercase tracking-wider text-zinc-500" data-add-suggestion-meta></div>
      </div>
      <span class="text-xs uppercase tracking-wider text-emerald-700 dark:text-emerald-400">elegir →</span>
    </div>
    <p
      class="mt-3 hidden rounded-lg border border-dashed border-zinc-300 p-3 text-center text-sm text-zinc-500 dark:border-white/10"
      data-add-search-empty
    >
      Sin coincidencias.
    </p>
  </div>

  <div class="p-4" data-add-perks-view hidden>
    <div class="mb-4 flex items-center gap-3 rounded-lg bg-zinc-100 p-3 dark:bg-white/[0.04]">
      <img alt="" class="h-12 w-12 rounded bg-white object-contain p-1 dark:bg-white/[0.02]" data-add-weapon-icon />
      <div class="min-w-0 flex-1">
        <div class="truncate font-medium" data-add-weapon-name></div>
        <div class="text-xs uppercase tracking-wider text-zinc-500" data-add-weapon-meta></div>
      </div>
    </div>

    <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div data-add-perk-slot="0">
        <label class="mb-1 block text-xs font-medium uppercase tracking-wider text-zinc-500">
          Perk 1
        </label>
        <input
          type="text"
          placeholder="Escribí el nombre (ej. Explosive Payload)"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
          data-add-perk-input
        />
        <div
          class="mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-zinc-200 bg-white p-1 dark:border-white/10 dark:bg-white/[0.02]"
          data-add-perk-suggestions
        ></div>
        <div
          class="mt-1 hidden items-center gap-2 rounded-lg border border-emerald-500/40 bg-emerald-500/5 p-2"
          data-add-perk-chip
        >
          <img alt="" class="h-7 w-7 shrink-0 rounded object-contain" data-add-perk-chip-icon />
          <span class="flex-1 truncate text-xs font-medium" data-add-perk-chip-name></span>
          <button
            type="button"
            class="text-zinc-400 hover:text-red-500 dark:hover:text-red-400"
            data-add-perk-chip-clear
            aria-label="Quitar"
          >
            ×
          </button>
        </div>
      </div>
      <div data-add-perk-slot="1">
        <label class="mb-1 block text-xs font-medium uppercase tracking-wider text-zinc-500">
          Perk 2
        </label>
        <input
          type="text"
          placeholder="Escribí el nombre (ej. Firefly)"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
          data-add-perk-input
        />
        <div
          class="mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-zinc-200 bg-white p-1 dark:border-white/10 dark:bg-white/[0.02]"
          data-add-perk-suggestions
        ></div>
        <div
          class="mt-1 hidden items-center gap-2 rounded-lg border border-emerald-500/40 bg-emerald-500/5 p-2"
          data-add-perk-chip
        >
          <img alt="" class="h-7 w-7 shrink-0 rounded object-contain" data-add-perk-chip-icon />
          <span class="flex-1 truncate text-xs font-medium" data-add-perk-chip-name></span>
          <button
            type="button"
            class="text-zinc-400 hover:text-red-500 dark:hover:text-red-400"
            data-add-perk-chip-clear
            aria-label="Quitar"
          >
            ×
          </button>
        </div>
      </div>
    </div>
  </div>

  <footer class="flex items-center justify-end gap-3 border-t border-zinc-200 p-4 dark:border-white/10">
    <button
      type="button"
      class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 dark:border-white/10 dark:text-zinc-200 dark:hover:bg-white/10"
      data-add-cancel
    >
      Cancelar
    </button>
    <button
      type="button"
      class="rounded-lg bg-zinc-900 px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-white transition disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-zinc-900"
      data-add-confirm
      disabled
    >
      Agregar
    </button>
  </footer>

  <p
    class="m-0 border-t border-zinc-200 px-4 py-2 text-center text-xs text-zinc-500 dark:border-white/10"
    data-add-status
    hidden
  ></p>
</dialog>

<template data-add-perk-suggestion-template>
  <button
    type="button"
    class="flex w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm text-zinc-900 hover:bg-zinc-100 dark:text-white dark:hover:bg-white/10"
    data-add-perk-suggestion
  >
    <img alt="" class="h-7 w-7 shrink-0 rounded object-contain" data-add-perk-suggestion-icon />
    <span class="flex-1 truncate text-xs" data-add-perk-suggestion-name></span>
    <span
      class="shrink-0 text-[10px] font-medium uppercase tracking-wider text-zinc-500"
      data-add-perk-suggestion-cat
    ></span>
  </button>
</template>

<script is:inline>
  (function () {
    const chip = document.querySelector('[data-add-weapon-chip]');
    const dialog = document.querySelector('[data-add-dialog]');
    if (!chip || !dialog) return;

    const titleEl = dialog.querySelector('[data-add-title]');
    const subtitleEl = dialog.querySelector('[data-add-subtitle]');
    const backBtn = dialog.querySelector('[data-add-back]');
    const closeBtn = dialog.querySelector('[data-add-close]');
    const cancelBtn = dialog.querySelector('[data-add-cancel]');
    const confirmBtn = dialog.querySelector('[data-add-confirm]');
    const statusEl = dialog.querySelector('[data-add-status]');

    const searchView = dialog.querySelector('[data-add-search-view]');
    const perksView = dialog.querySelector('[data-add-perks-view]');

    const input = dialog.querySelector('[data-add-input]');
    const suggestionEl = dialog.querySelector('[data-add-suggestion]');
    const suggestionIcon = dialog.querySelector('[data-add-suggestion-icon]');
    const suggestionName = dialog.querySelector('[data-add-suggestion-name]');
    const suggestionMeta = dialog.querySelector('[data-add-suggestion-meta]');
    const searchEmpty = dialog.querySelector('[data-add-search-empty]');

    const weaponIcon = dialog.querySelector('[data-add-weapon-icon]');
    const weaponName = dialog.querySelector('[data-add-weapon-name]');
    const weaponMeta = dialog.querySelector('[data-add-weapon-meta]');

    const perkSlots = Array.from(dialog.querySelectorAll('[data-add-perk-slot]'));
    const perkSlotInputs = perkSlots.map((s) => s.querySelector('[data-add-perk-input]'));
    const perkSlotSuggestions = perkSlots.map((s) => s.querySelector('[data-add-perk-suggestions]'));
    const perkSlotChips = perkSlots.map((s) => s.querySelector('[data-add-perk-chip]'));
    const perkSlotChipIcons = perkSlots.map((s) => s.querySelector('[data-add-perk-chip-icon]'));
    const perkSlotChipNames = perkSlots.map((s) => s.querySelector('[data-add-perk-chip-name]'));
    const perkSlotChipClears = perkSlots.map((s) => s.querySelector('[data-add-perk-chip-clear]'));

    const perkSuggestionTpl = document.querySelector(
      '[data-add-perk-suggestion-template]'
    );

    const MAX_PICKS = 2;

    const state = {
      viewMode: 'search',
      currentWeaponHash: null,
      perkPool: [],
      selectedPerkBySlot: [null, null],
      weaponTimer: null,
      perkTimers: [null, null],
      lastSearchValue: '',
    };

    function showView(mode) {
      state.viewMode = mode;
      if (mode === 'search') {
        searchView.hidden = false;
        perksView.hidden = true;
        backBtn.hidden = true;
        titleEl.textContent = 'Seleccioná un arma';
        subtitleEl.textContent = 'Buscá por nombre';
        statusEl.hidden = true;
      } else {
        searchView.hidden = true;
        perksView.hidden = false;
        backBtn.hidden = false;
        titleEl.textContent = 'Elegí 2 perks';
        subtitleEl.textContent = 'Tip: escribí parte del nombre';
        statusEl.hidden = true;
      }
    }

    function showStatus(msg, isError) {
      statusEl.textContent = msg;
      statusEl.hidden = false;
      statusEl.classList.toggle('text-red-500', isError);
      statusEl.classList.toggle('dark:text-red-400', isError);
    }

    function clearWeaponSuggestion() {
      suggestionEl.classList.add('hidden');
      suggestionEl.removeAttribute('data-weapon-hash');
      suggestionIcon.removeAttribute('src');
      suggestionName.textContent = '';
      suggestionMeta.textContent = '';
    }

    function showWeaponSuggestion(weapon) {
      suggestionIcon.src = '/destiny/api/icon?type=weapon&hash=' + encodeURIComponent(weapon.hash);
      suggestionIcon.alt = weapon.name;
      suggestionName.textContent = weapon.name;
      const meta = [];
      if (weapon.tier === 'exotic') meta.push('Exotic');
      if (weapon.damage) meta.push(weapon.damage);
      suggestionMeta.textContent = meta.join(' · ');
      suggestionEl.dataset.weaponHash = weapon.hash;
      suggestionEl.classList.remove('hidden');
      searchEmpty.classList.add('hidden');
    }

    function resetState() {
      state.currentWeaponHash = null;
      state.perkPool = [];
      state.selectedPerkBySlot = [null, null];
      state.lastSearchValue = '';
      input.value = '';
      clearWeaponSuggestion();
      searchEmpty.classList.add('hidden');
      weaponIcon.removeAttribute('src');
      weaponName.textContent = '';
      weaponMeta.textContent = '';
      perkSlots.forEach((_, i) => {
        perkSlotInputs[i].value = '';
        closePerkSuggestions(i);
        clearPerkChip(i);
      });
      statusEl.hidden = true;
      statusEl.textContent = '';
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Agregar';
      showView('search');
    }

    function setConfirmEnabled() {
      const both = state.selectedPerkBySlot[0] && state.selectedPerkBySlot[1];
      confirmBtn.disabled = !both;
    }

    function clearPerkChip(slotIdx) {
      state.selectedPerkBySlot[slotIdx] = null;
      perkSlotChips[slotIdx].classList.add('hidden');
      perkSlotChipIcons[slotIdx].removeAttribute('src');
      perkSlotChipNames[slotIdx].textContent = '';
      setConfirmEnabled();
    }

    function applyPerkSelection(slotIdx, perk) {
      state.selectedPerkBySlot[slotIdx] = perk.hash;
      perkSlotChips[slotIdx].classList.remove('hidden');
      perkSlotChipIcons[slotIdx].src = '/destiny/api/icon?type=perk&hash=' + encodeURIComponent(perk.hash);
      perkSlotChipIcons[slotIdx].alt = perk.name;
      perkSlotChipNames[slotIdx].textContent = perk.name;
      perkSlotInputs[slotIdx].value = perk.name;
      closePerkSuggestions(slotIdx);
      setConfirmEnabled();
    }

    function closePerkSuggestions(slotIdx) {
      perkSlotSuggestions[slotIdx].innerHTML = '';
      perkSlotSuggestions[slotIdx].classList.add('hidden');
    }

    function rankPerks(pool, q) {
      const matches = [];
      for (const p of pool) {
        const name = p.name.toLowerCase();
        if (name === q) return [p];
        if (name.startsWith(q)) {
          matches.push({ perk: p, score: 1 });
          continue;
        }
        const idx = name.indexOf(q);
        if (idx === -1) continue;
        matches.push({ perk: p, score: idx + 2 });
      }
      matches.sort((a, b) => {
        if (a.score !== b.score) return a.score - b.score;
        return a.perk.name.localeCompare(b.perk.name);
      });
      return matches.slice(0, 50).map((m) => m.perk);
    }

    function allPerksSorted(pool) {
      const CATEGORY_ORDER = { barrel: 0, magazine: 1, trait: 2 };
      const sorted = pool.slice().sort((a, b) => {
        const ca = CATEGORY_ORDER[a.categoryKey] ?? 99;
        const cb = CATEGORY_ORDER[b.categoryKey] ?? 99;
        if (ca !== cb) return ca - cb;
        return a.name.localeCompare(b.name);
      });
      return sorted.slice(0, 50);
    }

    function renderPerkSuggestions(slotIdx, perks) {
      const container = perkSlotSuggestions[slotIdx];
      container.innerHTML = '';
      if (!perks.length) {
        container.classList.add('hidden');
        return;
      }
      for (const p of perks) {
        const node = perkSuggestionTpl.content.firstElementChild.cloneNode(true);
        node.dataset.perkHash = p.hash;
        node.dataset.perkName = p.name;
        const icon = node.querySelector('[data-add-perk-suggestion-icon]');
        icon.src = '/destiny/api/icon?type=perk&hash=' + encodeURIComponent(p.hash);
        icon.alt = p.name;
        node.querySelector('[data-add-perk-suggestion-name]').textContent = p.name;
        node.querySelector('[data-add-perk-suggestion-cat]').textContent = p.categoryKey;
        container.appendChild(node);
      }
      container.classList.remove('hidden');
    }

    async function searchWeapon(q) {
      try {
        const res = await fetch('/destiny/api/search?q=' + encodeURIComponent(q));
        if (!res.ok) {
          clearWeaponSuggestion();
          searchEmpty.classList.add('hidden');
          return;
        }
        const data = await res.json();
        if (data.result) {
          showWeaponSuggestion(data.result);
        } else {
          clearWeaponSuggestion();
          searchEmpty.classList.remove('hidden');
        }
      } catch {
        clearWeaponSuggestion();
      }
    }

    async function fetchWeaponPerks(hash) {
      try {
        const res = await fetch('/destiny/api/weapon-perks?hash=' + encodeURIComponent(hash));
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          showStatus(err.message || 'No se pudo cargar el arma.', true);
          return null;
        }
        const data = await res.json();
        if (data.error) {
          showStatus(data.message || 'No se pudo cargar el arma.', true);
          return null;
        }
        return data;
      } catch {
        showStatus('Error de red. Probá de nuevo.', true);
        return null;
      }
    }

    async function pickWeapon(weaponHash) {
      if (!weaponHash) return;
      clearWeaponSuggestion();
      showView('perks');
      const data = await fetchWeaponPerks(weaponHash);
      if (!data) {
        showView('search');
        return;
      }
      state.currentWeaponHash = data.weapon.hash;
      weaponIcon.src = '/destiny/api/icon?type=weapon&hash=' + encodeURIComponent(data.weapon.hash);
      weaponIcon.alt = data.weapon.name;
      weaponName.textContent = data.weapon.name;
      const meta = [];
      if (data.weapon.tier === 'exotic') meta.push('Exotic');
      if (data.weapon.damage) meta.push(data.weapon.damage);
      weaponMeta.textContent = meta.join(' · ');
      state.perkPool = data.perks;
      setTimeout(() => perkSlotInputs[0].focus(), 50);
    }

    input.addEventListener('input', () => {
      clearTimeout(state.weaponTimer);
      const q = input.value.trim();
      state.lastSearchValue = q;
      if (q.length < 2) {
        clearWeaponSuggestion();
        searchEmpty.classList.add('hidden');
        return;
      }
      state.weaponTimer = setTimeout(() => {
        if (state.lastSearchValue !== q) return;
        searchWeapon(q);
      }, 200);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const hash = suggestionEl.dataset.weaponHash;
        if (hash) pickWeapon(hash);
      } else if (e.key === 'Escape') {
        clearWeaponSuggestion();
      }
    });

    suggestionEl.addEventListener('click', () => {
      const hash = suggestionEl.dataset.weaponHash;
      if (hash) pickWeapon(hash);
    });
    suggestionEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const hash = suggestionEl.dataset.weaponHash;
        if (hash) pickWeapon(hash);
      }
    });

    perkSlots.forEach((_, i) => {
      perkSlotInputs[i].addEventListener('input', () => {
        clearTimeout(state.perkTimers[i]);
        const q = perkSlotInputs[i].value.trim();
        if (!q) {
          renderPerkSuggestions(i, allPerksSorted(state.perkPool));
          return;
        }
        state.perkTimers[i] = setTimeout(() => {
          const ranked = rankPerks(state.perkPool, q.toLowerCase());
          renderPerkSuggestions(i, ranked);
        }, 120);
      });

      perkSlotInputs[i].addEventListener('focus', () => {
        renderPerkSuggestions(i, allPerksSorted(state.perkPool));
      });

      perkSlotSuggestions[i].addEventListener('click', (e) => {
        const btn = e.target.closest('[data-add-perk-suggestion]');
        if (!btn) return;
        const hash = btn.dataset.perkHash;
        const name = btn.dataset.perkName;
        applyPerkSelection(i, {
          hash,
          name,
          categoryKey: state.perkPool.find((p) => p.hash === hash)?.categoryKey ?? '',
        });
      });

      perkSlotChipClears[i].addEventListener('click', () => {
        clearPerkChip(i);
      });
    });

    backBtn.addEventListener('click', () => {
      if (state.viewMode === 'perks') {
        showView('search');
      }
    });

    closeBtn.addEventListener('click', closeDialog);
    cancelBtn.addEventListener('click', closeDialog);
    chip.addEventListener('click', () => {
      resetState();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      setTimeout(() => input.focus(), 50);
    });

    function closeDialog() {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
    }

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });
    dialog.addEventListener('cancel', closeDialog);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dialog.open) closeDialog();
    });

    async function confirmAdd() {
      if (!state.currentWeaponHash) return;
      const perks = state.selectedPerkBySlot.filter(Boolean);
      if (perks.length !== MAX_PICKS) return;
      confirmBtn.disabled = true;
      cancelBtn.disabled = true;
      const originalText = confirmBtn.textContent;
      confirmBtn.textContent = 'Agregando…';
      try {
        const res = await fetch('/destiny/api/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            itemHash: state.currentWeaponHash,
            perkHashes: perks,
          }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          if (res.status === 409) {
            showStatus('Ya está en tu wishlist.', true);
          } else if (res.status === 400) {
            showStatus(data.message || 'Perks inválidas.', true);
          } else if (res.status === 401) {
            showStatus('Sesión expirada. Recargá la página.', true);
          } else if (res.status === 404) {
            showStatus('Arma no encontrada.', true);
          } else {
            showStatus(data.message || 'Error al agregar.', true);
          }
          confirmBtn.disabled = false;
          cancelBtn.disabled = false;
          confirmBtn.textContent = originalText;
          setConfirmEnabled();
          return;
        }
        const data = await res.json();
        closeDialog();
        window.dispatchEvent(
          new CustomEvent('destiny:weapon-added', { detail: data.weapon })
        );
      } catch {
        showStatus('Error de red. Probá de nuevo.', true);
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
        confirmBtn.textContent = originalText;
        setConfirmEnabled();
      }
    }

    confirmBtn.addEventListener('click', confirmAdd);

    window.addEventListener('destiny:open-add-weapon', () => {
      resetState();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      setTimeout(() => input.focus(), 50);
    });
  })();
</script>

