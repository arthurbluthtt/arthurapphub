---
---
<button
  type="button"
  class="fixed bottom-16 right-4 z-30 inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-900 shadow-md transition hover:-translate-y-0.5 hover:shadow-lg dark:border-white/10 dark:bg-zinc-800 dark:text-white"
  data-custom-perk-icon-chip
  aria-label="Icono de perk custom"
  title="Para perks que no se encuentran en el manifest"
>
  <span class="text-sm leading-none">✦</span>
  <span>Icono perk</span>
</button>

<button
  type="button"
  class="fixed bottom-4 right-4 z-30 inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-900 shadow-md transition hover:-translate-y-0.5 hover:shadow-lg dark:border-white/10 dark:bg-zinc-800 dark:text-white"
  data-add-weapon-chip
  aria-label="Agregar arma"
>
  <span class="text-sm leading-none">+</span>
  <span>Agregar arma</span>
</button>

<dialog
  class="backdrop:bg-zinc-900/95 dark:bg-zinc-950/95 m-auto max-h-[90vh] w-[min(900px,calc(100vw-2rem))] overflow-y-auto overscroll-contain rounded-2xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-2xl dark:border-white/10 dark:bg-zinc-900 dark:text-white"
  data-add-dialog
>
  <header class="flex items-center gap-3 border-b border-zinc-200 p-4 dark:border-white/10">
    <button
      type="button"
      class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
      data-add-back
      aria-label="Volver"
      hidden
    >
      ←
    </button>
    <div class="flex-1 min-w-0">
      <h2 class="font-semibold truncate" data-add-title>Seleccioná un arma</h2>
      <p class="text-xs uppercase tracking-wider text-zinc-500" data-add-subtitle>
        Buscá por nombre
      </p>
    </div>
    <button
      type="button"
      class="grid h-8 w-8 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
      data-add-close
      aria-label="Cerrar"
    >
      ×
    </button>
  </header>

  <div class="p-4" data-add-search-view>
    <input
      type="text"
      placeholder="Buscar arma (ej. Fatebringer, Mountaintop…)"
      autocomplete="off"
      spellcheck="false"
      autocapitalize="off"
      autocorrect="off"
      class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
      data-add-input
    />
    <div
      class="mt-3 hidden cursor-pointer items-center gap-3 rounded-lg border border-emerald-500/40 bg-emerald-500/5 p-3 hover:bg-emerald-500/10"
      data-add-suggestion
      role="button"
      tabindex="0"
    >
      <img alt="" class="h-10 w-10 shrink-0 rounded bg-white object-contain p-1 dark:bg-white/[0.02]" data-add-suggestion-icon />
      <div class="min-w-0 flex-1">
        <div class="truncate font-medium" data-add-suggestion-name></div>
        <div class="text-xs uppercase tracking-wider text-zinc-500" data-add-suggestion-meta></div>
      </div>
      <span class="text-xs uppercase tracking-wider text-emerald-700 dark:text-emerald-400">elegir →</span>
    </div>
    <p
      class="mt-3 hidden rounded-lg border border-dashed border-zinc-300 p-3 text-center text-sm text-zinc-500 dark:border-white/10"
      data-add-search-empty
    >
      Sin coincidencias.
    </p>
  </div>

  <div class="p-4" data-add-perks-view hidden>
    <div class="mb-4 flex items-center gap-3 rounded-lg bg-zinc-100 p-3 dark:bg-white/[0.04]">
      <img alt="" class="h-12 w-12 rounded bg-white object-contain p-1 dark:bg-white/[0.02]" data-add-weapon-icon />
      <div class="min-w-0 flex-1">
        <div class="truncate font-medium" data-add-weapon-name></div>
        <div class="text-xs uppercase tracking-wider text-zinc-500" data-add-weapon-meta></div>
      </div>
      <button
        type="button"
        class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
        data-add-back-inline
        aria-label="Cambiar arma"
        title="Cambiar arma"
      >
        ←
      </button>
    </div>

    <p class="mb-3 text-xs text-zinc-500">
      Escribí el nombre de cada perk. Al guardar, la página lo busca y agrega el icono.
    </p>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <label class="relative block">
        <span class="mb-1 block text-xs font-medium uppercase tracking-wider text-zinc-500">
          Cañón
        </span>
        <input
          type="text"
          placeholder="ej. Fluted Barrel"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          data-add-perk-input
          data-add-perk-slot="barrel"
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
        />
        <div
          class="absolute z-20 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-zinc-300 bg-white p-1 text-zinc-900 shadow-2xl ring-1 ring-black/5 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
          data-add-perk-suggestions
          data-add-perk-suggestions-for="barrel"
        ></div>
      </label>
      <label class="relative block">
        <span class="mb-1 block text-xs font-medium uppercase tracking-wider text-zinc-500">
          Cargador
        </span>
        <input
          type="text"
          placeholder="ej. Accurized Rounds"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          data-add-perk-input
          data-add-perk-slot="magazine"
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
        />
        <div
          class="absolute z-20 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-zinc-300 bg-white p-1 text-zinc-900 shadow-2xl ring-1 ring-black/5 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
          data-add-perk-suggestions
          data-add-perk-suggestions-for="magazine"
        ></div>
      </label>
      <label class="relative block">
        <span class="mb-1 block text-xs font-medium uppercase tracking-wider text-zinc-500">
          Rasgo 1
        </span>
        <input
          type="text"
          placeholder="ej. Explosive Payload"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          data-add-perk-input
          data-add-perk-slot="perk1"
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
        />
        <div
          class="absolute z-20 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-zinc-300 bg-white p-1 text-zinc-900 shadow-2xl ring-1 ring-black/5 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
          data-add-perk-suggestions
          data-add-perk-suggestions-for="perk1"
        ></div>
      </label>
      <label class="relative block">
        <span class="mb-1 block text-xs font-medium uppercase tracking-wider text-zinc-500">
          Rasgo 2
        </span>
        <input
          type="text"
          placeholder="ej. Firefly"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          data-add-perk-input
          data-add-perk-slot="perk2"
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
        />
        <div
          class="absolute z-20 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-zinc-300 bg-white p-1 text-zinc-900 shadow-2xl ring-1 ring-black/5 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
          data-add-perk-suggestions
          data-add-perk-suggestions-for="perk2"
        ></div>
      </label>
    </div>
  </div>

  <footer class="flex items-center justify-end gap-3 border-t border-zinc-200 p-4 dark:border-white/10">
    <button
      type="button"
      class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 dark:border-white/10 dark:text-zinc-200 dark:hover:bg-white/10"
      data-add-cancel
    >
      Cancelar
    </button>
    <button
      type="button"
      class="rounded-lg bg-zinc-900 px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-white transition disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-zinc-900"
      data-add-confirm
      disabled
    >
      Agregar
    </button>
  </footer>

  <p
    class="m-0 border-t border-zinc-200 px-4 py-2 text-center text-xs text-zinc-500 dark:border-white/10"
    data-add-status
    hidden
  ></p>
</dialog>

<script is:inline>
  (function () {
    const chip = document.querySelector('[data-add-weapon-chip]');
    const dialog = document.querySelector('[data-add-dialog]');
    if (!chip || !dialog) return;

    const titleEl = dialog.querySelector('[data-add-title]');
    const subtitleEl = dialog.querySelector('[data-add-subtitle]');
    const backBtn = dialog.querySelector('[data-add-back]');
    const backInlineBtn = dialog.querySelector('[data-add-back-inline]');
    const closeBtn = dialog.querySelector('[data-add-close]');
    const cancelBtn = dialog.querySelector('[data-add-cancel]');
    const confirmBtn = dialog.querySelector('[data-add-confirm]');
    const statusEl = dialog.querySelector('[data-add-status]');

    const searchView = dialog.querySelector('[data-add-search-view]');
    const perksView = dialog.querySelector('[data-add-perks-view]');

    const input = dialog.querySelector('[data-add-input]');
    const suggestionEl = dialog.querySelector('[data-add-suggestion]');
    const suggestionIcon = dialog.querySelector('[data-add-suggestion-icon]');
    const suggestionName = dialog.querySelector('[data-add-suggestion-name]');
    const suggestionMeta = dialog.querySelector('[data-add-suggestion-meta]');
    const searchEmpty = dialog.querySelector('[data-add-search-empty]');

    const weaponIcon = dialog.querySelector('[data-add-weapon-icon]');
    const weaponName = dialog.querySelector('[data-add-weapon-name]');
    const weaponMeta = dialog.querySelector('[data-add-weapon-meta]');

    const perkInputs = Array.from(dialog.querySelectorAll('[data-add-perk-input]'));
    const perkSuggestionContainers = {};
    perkInputs.forEach((el) => {
      const slot = el.getAttribute('data-add-perk-slot');
      perkSuggestionContainers[slot] = dialog.querySelector(
        `[data-add-perk-suggestions-for="${slot}"]`
      );
    });

    const PERK_SLOTS = ['barrel', 'magazine', 'perk1', 'perk2'];
    const perkMatchTimers = {};

const state = {
      viewMode: 'search',
      mode: 'add',
      currentWeaponHash: null,
      currentWeaponName: '',
      weaponTimer: null,
      lastSearchValue: '',
      perkConfirmed: {},
      perkConfirmedValue: {},
    };

    function showView(mode) {
      state.viewMode = mode;
      if (state.mode === 'edit') {
        searchView.hidden = true;
        perksView.hidden = false;
        backBtn.hidden = true;
        titleEl.textContent = 'Editar perks';
        subtitleEl.textContent = 'Modificá los nombres y guardá';
        statusEl.hidden = true;
        return;
      }
      if (mode === 'search') {
        searchView.hidden = false;
        perksView.hidden = true;
        backBtn.hidden = true;
        titleEl.textContent = 'Seleccioná un arma';
        subtitleEl.textContent = 'Buscá por nombre';
        statusEl.hidden = true;
      } else {
        searchView.hidden = true;
        perksView.hidden = false;
        backBtn.hidden = false;
        titleEl.textContent = 'Elegí los perks';
        subtitleEl.textContent = 'Tip: escribí el nombre exacto del perk';
        statusEl.hidden = true;
      }
    }

    function showStatus(msg, isError) {
      statusEl.textContent = msg;
      statusEl.hidden = false;
      statusEl.classList.toggle('text-red-500', isError);
      statusEl.classList.toggle('dark:text-red-400', isError);
    }

    function clearWeaponSuggestion() {
      suggestionEl.classList.add('hidden');
      suggestionEl.removeAttribute('data-weapon-hash');
      suggestionIcon.removeAttribute('src');
      suggestionName.textContent = '';
      suggestionMeta.textContent = '';
    }

    function showWeaponSuggestion(weapon) {
      suggestionIcon.src = '/destiny/api/icon?type=weapon&hash=' + encodeURIComponent(weapon.hash);
      suggestionIcon.alt = weapon.name;
      suggestionName.textContent = weapon.name;
      const meta = [];
      if (weapon.tier === 'exotic') meta.push('Exotic');
      if (weapon.damage) meta.push(weapon.damage);
      suggestionMeta.textContent = meta.join(' · ');
      suggestionEl.dataset.weaponHash = weapon.hash;
      suggestionEl.classList.remove('hidden');
      searchEmpty.classList.add('hidden');
    }

function resetState() {
      state.currentWeaponHash = null;
      state.currentWeaponName = '';
      state.mode = 'add';
      state.lastSearchValue = '';
      state.perkConfirmed = {};
      state.perkConfirmedValue = {};
      input.value = '';
      clearWeaponSuggestion();
      searchEmpty.classList.add('hidden');
      weaponIcon.removeAttribute('src');
      weaponName.textContent = '';
      weaponMeta.textContent = '';
      perkInputs.forEach((el) => { el.value = ''; });
      statusEl.hidden = true;
      statusEl.textContent = '';
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Agregar';
      showView('search');
    }

function openForEdit(row) {
      resetState();
      state.mode = 'edit';
      state.currentWeaponHash = row.itemHash;
      state.currentWeaponName = row.name || '';
      weaponIcon.src = '/destiny/api/icon?type=weapon&hash=' + encodeURIComponent(row.itemHash);
      weaponIcon.alt = row.name || '';
      weaponName.textContent = row.name || '';
      weaponMeta.textContent = '';
      lockBodyScroll();
      perkInputs.forEach((el) => {
        const slot = el.getAttribute('data-add-perk-slot');
        const v = row.perks && row.perks[slot];
        const val = typeof v === 'string' ? v : '';
        el.value = val;
        if (val) {
          state.perkConfirmed[slot] = true;
          state.perkConfirmedValue[slot] = val;
        }
      });
      confirmBtn.textContent = 'Guardar';
      checkPerksComplete();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      showView('perks');
      setTimeout(() => perkInputs[0].focus(), 50);
    }

    function checkPerksComplete() {
      const filled = perkInputs.every((el) => el.value.trim().length > 0);
      confirmBtn.disabled = !filled || !state.currentWeaponHash;
    }

    async function searchWeapon(q) {
      try {
        const res = await fetch('/destiny/api/search?q=' + encodeURIComponent(q));
        if (!res.ok) {
          clearWeaponSuggestion();
          searchEmpty.classList.add('hidden');
          return;
        }
        const data = await res.json();
        if (data.result) {
          showWeaponSuggestion(data.result);
        } else {
          clearWeaponSuggestion();
          searchEmpty.classList.remove('hidden');
        }
      } catch {
        clearWeaponSuggestion();
      }
    }

async function pickWeapon(weaponHash, name) {
      if (!weaponHash) return;
      clearWeaponSuggestion();
      state.currentWeaponHash = weaponHash;
      weaponIcon.src = '/destiny/api/icon?type=weapon&hash=' + encodeURIComponent(weaponHash);
      weaponIcon.alt = name || '';
      weaponName.textContent = name || '';
      weaponMeta.textContent = '';
      showView('perks');
      state.perkConfirmed = {};
      state.perkConfirmedValue = {};
      perkInputs.forEach((el) => { el.value = ''; });
      checkPerksComplete();
      setTimeout(() => perkInputs[0].focus(), 50);
    }

    input.addEventListener('input', () => {
      clearTimeout(state.weaponTimer);
      const q = input.value.trim();
      state.lastSearchValue = q;
      if (q.length < 2) {
        clearWeaponSuggestion();
        searchEmpty.classList.add('hidden');
        return;
      }
      state.weaponTimer = setTimeout(() => {
        if (state.lastSearchValue !== q) return;
        searchWeapon(q);
      }, 200);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const hash = suggestionEl.dataset.weaponHash;
        const name = suggestionName.textContent;
        if (hash) pickWeapon(hash, name);
      } else if (e.key === 'Escape') {
        clearWeaponSuggestion();
      }
    });

    suggestionEl.addEventListener('click', () => {
      const hash = suggestionEl.dataset.weaponHash;
      const name = suggestionName.textContent;
      if (hash) pickWeapon(hash, name);
    });
    suggestionEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const hash = suggestionEl.dataset.weaponHash;
        const name = suggestionName.textContent;
        if (hash) pickWeapon(hash, name);
      }
    });

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[c]);
    }

    function closePerkSuggestions(slot) {
      const c = perkSuggestionContainers[slot];
      if (c) {
        c.innerHTML = '';
        c.classList.add('hidden');
      }
    }

    // Posiciona el dropdown debajo del input (position:absolute relativo
    // al <label class="relative"> que ya lo contiene). El dialog tiene
    // overflow-y-auto asi que no hay clipping, y el dropdown sigue
    // naturalmente el flow del label al scrollear.
    //
    // Solo ajustamos ancho/offset horizontal para alinearlo al input
    // (no al label, que es la columna completa del grid), y max-height
    // + inversion (top<->bottom) segun el espacio disponible en el
    // viewport: si no entra abajo, abre hacia arriba.
    function positionDropdown(slot) {
      const slotIndex = PERK_SLOTS.indexOf(slot);
      if (slotIndex < 0) return;
      const input = perkInputs[slotIndex];
      const dropdown = perkSuggestionContainers[slot];
      if (!input || !dropdown) return;
      const rect = input.getBoundingClientRect();
      const label = input.parentElement;
      const labelRect = label ? label.getBoundingClientRect() : rect;
      const gap = 4;
      const maxH = 288;
      const viewportH = window.innerHeight;
      const spaceBelow = viewportH - rect.bottom - gap;
      const spaceAbove = rect.top - gap;
      const minSpace = 120;

      // Ancho y offset horizontal: alinear al input, no al label.
      dropdown.style.left = (rect.left - labelRect.left) + 'px';
      dropdown.style.width = rect.width + 'px';

      // Vertical: debajo por default; arriba si no hay espacio.
      if (spaceBelow >= minSpace) {
        dropdown.style.top = '100%';
        dropdown.style.bottom = 'auto';
        dropdown.style.marginTop = gap + 'px';
        dropdown.style.marginBottom = '0';
        dropdown.style.maxHeight = Math.min(maxH, spaceBelow) + 'px';
      } else if (spaceAbove > spaceBelow) {
        dropdown.style.top = 'auto';
        dropdown.style.bottom = '100%';
        dropdown.style.marginTop = '0';
        dropdown.style.marginBottom = gap + 'px';
        dropdown.style.maxHeight = Math.min(maxH, spaceAbove) + 'px';
      } else {
        dropdown.style.top = '100%';
        dropdown.style.bottom = 'auto';
        dropdown.style.marginTop = gap + 'px';
        dropdown.style.marginBottom = '0';
        dropdown.style.maxHeight = Math.min(maxH, Math.max(spaceBelow, spaceAbove)) + 'px';
      }
    }

    function renderPerkSuggestions(input, slot, items, groups) {
      const c = perkSuggestionContainers[slot];
      if (!c) return;
      c.innerHTML = '';
      const list = (groups && groups.length)
        ? groups
        : [{ key: 'all', label: '', perks: items || [] }];
      const totalPerks = list.reduce((acc, g) => acc + g.perks.length, 0);
      if (!totalPerks) {
        c.classList.add('hidden');
        return;
      }
      for (const group of list) {
        if (!group.perks || !group.perks.length) continue;
        if (group.label) {
          const header = document.createElement('div');
          header.className =
            'px-2 pt-1.5 pb-1 text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-400';
          header.textContent = group.label;
          c.appendChild(header);
        }
        for (const it of group.perks) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.perkName = it.name;
          btn.dataset.perkSlot = slot;
          btn.className =
            'flex w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm text-zinc-900 hover:bg-zinc-100 dark:text-zinc-100 dark:hover:bg-white/10';
          const iconUrl = it.icon || "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23e4e4e7'/></svg>";
          const tag = it.isCustom ? 'custom' : (it.category || '');
          btn.innerHTML = `
            <img alt="" class="h-7 w-7 shrink-0 rounded object-contain" src="${escapeHtml(iconUrl)}" />
            <span class="flex-1 truncate text-xs">${escapeHtml(it.name)}</span>
            ${tag ? `<span class="shrink-0 text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-400">${escapeHtml(tag)}</span>` : ''}
          `;
          btn.addEventListener('click', () => {
            input.value = it.name;
            state.perkConfirmed[slot] = true;
            state.perkConfirmedValue[slot] = it.name;
            closePerkSuggestions(slot);
            checkPerksComplete();
            input.focus();
          });
          c.appendChild(btn);
        }
      }
      c.classList.remove('hidden');
      positionDropdown(slot);
    }

    perkInputs.forEach((el) => {
      const slot = el.getAttribute('data-add-perk-slot');
      el.addEventListener('input', () => {
        const currentVal = el.value.trim();
        if (state.perkConfirmed[slot] && currentVal === state.perkConfirmedValue[slot]) {
          checkPerksComplete();
          return;
        }
        if (state.perkConfirmed[slot] && currentVal !== state.perkConfirmedValue[slot]) {
          state.perkConfirmed[slot] = false;
          state.perkConfirmedValue[slot] = '';
        }
        checkPerksComplete();
        clearTimeout(perkMatchTimers[slot]);
        // Siempre hacemos fetch: con q vacio el endpoint devuelve TODOS los
        // elegibles para el slot (rankMatch trata q vacio como match-all).
        perkMatchTimers[slot] = setTimeout(async () => {
          try {
            const res = await fetch(
              '/destiny/api/perks/match?q=' +
                encodeURIComponent(el.value.trim()) +
                '&slot=' +
                encodeURIComponent(slot) +
                '&limit=30'
            );
            if (!res.ok) {
              closePerkSuggestions(slot);
              return;
            }
            const data = await res.json();
            renderPerkSuggestions(el, slot, data.results || [], data.groups || []);
          } catch {
            closePerkSuggestions(slot);
          }
        }, 140);
      });
      el.addEventListener('focus', () => {
        const event = new Event('input');
        el.dispatchEvent(event);
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          confirmBtn.click();
        } else if (e.key === 'Escape') {
          closePerkSuggestions(slot);
        }
      });
    });

    // Re-posicionar dropdowns cuando el usuario scrollea dentro del dialog
    // o redimensiona la ventana. Como el dropdown es absolute dentro del
    // <label>, sigue al input naturalmente al scrollear; solo necesitamos
    // ajustar max-height e inversion (top<->bottom) segun el nuevo
    // espacio disponible en el viewport.
    function repositionAllDropdowns() {
      for (const slot of PERK_SLOTS) {
        const dropdown = perkSuggestionContainers[slot];
        if (dropdown && !dropdown.classList.contains('hidden')) {
          positionDropdown(slot);
        }
      }
    }
    window.addEventListener('scroll', (e) => {
      // Si el scroll ocurre dentro del propio dropdown, no reposicionar
      // (seria molesto: el dropdown se moveria mientras el usuario baja
      // en la lista de perks).
      for (const slot of PERK_SLOTS) {
        const dropdown = perkSuggestionContainers[slot];
        if (dropdown && !dropdown.classList.contains('hidden') && dropdown.contains(e.target)) {
          return;
        }
      }
      repositionAllDropdowns();
    }, true);
    window.addEventListener('resize', repositionAllDropdowns);

    function backToSearch() {
      if (state.viewMode === 'perks') showView('search');
    }

    backBtn.addEventListener('click', backToSearch);
    backInlineBtn.addEventListener('click', backToSearch);

    closeBtn.addEventListener('click', closeDialog);
    cancelBtn.addEventListener('click', closeDialog);
chip.addEventListener('click', () => {
      resetState();
      lockBodyScroll();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      setTimeout(() => input.focus(), 50);
    });

function closeDialog() {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
      unlockBodyScroll();
    }

    // Bloquea el scroll de la pagina principal mientras el dialog esta
    // abierto. dialog.showModal() no bloquea el scroll del body de forma
    // confiable en todos los navegadores cuando hay un backdrop translucido,
    // asi que lockeamos via CSS y compensamos el ancho de la scrollbar
    // para que el contenido no salte al abrir/cerrar.
    let bodyLocked = false;
    function lockBodyScroll() {
      if (bodyLocked) return;
      bodyLocked = true;
      const sbw = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = 'hidden';
      if (sbw > 0) document.body.style.paddingRight = sbw + 'px';
    }
    function unlockBodyScroll() {
      if (!bodyLocked) return;
      bodyLocked = false;
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
    }

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });
    dialog.addEventListener('cancel', closeDialog);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dialog.open) closeDialog();
    });

    async function confirmAdd() {
      if (!state.currentWeaponHash) return;
      const perks = {};
      for (const el of perkInputs) {
        const slot = el.getAttribute('data-add-perk-slot');
        perks[slot] = { name: el.value.trim() };
      }
      confirmBtn.disabled = true;
      cancelBtn.disabled = true;
      const originalText = confirmBtn.textContent;
      const isEdit = state.mode === 'edit';
      confirmBtn.textContent = isEdit ? 'Guardando…' : 'Agregando…';
      const endpoint = isEdit ? '/destiny/api/update' : '/destiny/api/add';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            itemHash: state.currentWeaponHash,
            barrel: perks.barrel,
            magazine: perks.magazine,
            perk1: perks.perk1,
            perk2: perks.perk2,
          }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          if (res.status === 409) {
            showStatus('Ya está en tu wishlist.', true);
          } else if (res.status === 400) {
            showStatus(data.message || 'Faltan perks.', true);
          } else if (res.status === 401) {
            showStatus('Sesión expirada. Recargá la página.', true);
          } else if (res.status === 404) {
            showStatus('Arma no encontrada.', true);
          } else {
            showStatus(data.message || (isEdit ? 'Error al guardar.' : 'Error al agregar.'), true);
          }
          confirmBtn.disabled = false;
          cancelBtn.disabled = false;
          confirmBtn.textContent = originalText;
          checkPerksComplete();
          return;
        }
        const data = await res.json();
        closeDialog();
        window.dispatchEvent(
          new CustomEvent(
            isEdit ? 'destiny:weapon-updated' : 'destiny:weapon-added',
            { detail: data.weapon }
          )
        );
      } catch {
        showStatus('Error de red. Probá de nuevo.', true);
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
        confirmBtn.textContent = originalText;
        checkPerksComplete();
      }
    }

    confirmBtn.addEventListener('click', confirmAdd);

window.addEventListener('destiny:open-add-weapon', () => {
      resetState();
      lockBodyScroll();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      setTimeout(() => input.focus(), 50);
    });

    window.addEventListener('destiny:edit-weapon', (e) => {
      const row = e && e.detail;
      if (!row || !row.itemHash) return;
      openForEdit(row);
    });
  })();
</script>

