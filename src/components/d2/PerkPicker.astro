---
---
<dialog
  class="backdrop:bg-zinc-900/60 dark:bg-zinc-950/70 max-w-2xl rounded-2xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-2xl dark:border-white/10 dark:bg-zinc-900 dark:text-white"
  data-perk-picker
>
  <header class="flex items-center gap-3 border-b border-zinc-200 p-4 dark:border-white/10">
    <img
      alt=""
      class="h-12 w-12 rounded-lg bg-zinc-100 object-contain p-1 dark:bg-white/[0.04]"
      data-picker-weapon-icon
    />
    <div class="flex-1">
      <h2 class="font-semibold" data-picker-weapon-name>Seleccioná perks</h2>
      <p class="text-xs uppercase tracking-wider text-zinc-500" data-picker-weapon-meta></p>
    </div>
    <button
      type="button"
      class="grid h-8 w-8 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
      data-picker-close
      aria-label="Cerrar"
    >
      ×
    </button>
  </header>

  <div class="max-h-[60vh] overflow-y-auto p-4" data-picker-body>
    <div
      class="rounded-xl border border-dashed border-zinc-300 p-6 text-center text-sm text-zinc-500 dark:border-white/10"
      data-picker-empty
      hidden
    >
      Esta arma no tiene perks configurables.
    </div>
    <div class="space-y-5" data-picker-sections></div>
  </div>

  <footer class="flex items-center justify-between gap-3 border-t border-zinc-200 p-4 dark:border-white/10">
    <div class="flex-1 text-xs text-zinc-500" data-picker-status>
      Elegí 2 perks para tu wishlist.
    </div>
    <button
      type="button"
      class="rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 dark:border-white/10 dark:text-zinc-200 dark:hover:bg-white/10"
      data-picker-cancel
    >
      Cancelar
    </button>
    <button
      type="button"
      class="rounded-lg bg-zinc-900 px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-white transition disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-zinc-900"
      data-picker-confirm
      disabled
    >
      Agregar
    </button>
  </footer>
</dialog>

<template data-picker-section-template>
  <section data-picker-section>
    <h3
      class="mb-2 text-xs font-medium uppercase tracking-wider text-zinc-500"
      data-picker-section-title
    ></h3>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-picker-section-grid></div>
  </section>
</template>

<template data-picker-perk-template>
  <button
    type="button"
    class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-white p-2 text-left text-sm transition hover:border-zinc-400 data-[selected]:border-emerald-500 data-[selected]:bg-emerald-500/10 dark:border-white/10 dark:bg-white/[0.02] dark:hover:border-white/30"
    data-picker-perk
  >
    <img alt="" class="h-9 w-9 shrink-0 rounded object-contain" data-picker-perk-icon />
    <span class="flex-1 truncate text-xs" data-picker-perk-name></span>
    <span
      class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-emerald-500 text-[10px] font-semibold text-white opacity-0 transition data-[selected]:opacity-100"
      data-picker-perk-check
      aria-hidden="true"
    >
      ✓
    </span>
  </button>
</template>

<script is:inline>
  (function () {
    const dialog = document.querySelector('[data-perk-picker]');
    if (!dialog) return;
    const weaponIcon = dialog.querySelector('[data-picker-weapon-icon]');
    const weaponName = dialog.querySelector('[data-picker-weapon-name]');
    const weaponMeta = dialog.querySelector('[data-picker-weapon-meta]');
    const sectionsEl = dialog.querySelector('[data-picker-sections]');
    const emptyEl = dialog.querySelector('[data-picker-empty]');
    const statusEl = dialog.querySelector('[data-picker-status]');
    const confirmBtn = dialog.querySelector('[data-picker-confirm]');
    const cancelBtn = dialog.querySelector('[data-picker-cancel]');
    const closeBtn = dialog.querySelector('[data-picker-close]');
    const sectionTemplate = document.querySelector('[data-picker-section-template]');
    const perkTemplate = document.querySelector('[data-picker-perk-template]');

    let currentItemHash = null;
    let selected = [];
    let currentOnAdded = null;

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[c]);
    }

    function renderPerks(perks) {
      sectionsEl.innerHTML = '';
      emptyEl.hidden = perks.length > 0;
      const byCategory = new Map();
      for (const p of perks) {
        if (!byCategory.has(p.category)) byCategory.set(p.category, []);
        byCategory.get(p.category).push(p);
      }
      const ORDER = ['barrel', 'magazine', 'trait'];
      const LABELS = { barrel: 'Barrels', magazine: 'Mags', trait: 'Traits' };
      let rendered = false;
      for (const key of ORDER) {
        const items = byCategory.get(key);
        if (!items || items.length === 0) continue;
        rendered = true;
        const sectionNode = sectionTemplate.content.firstElementChild.cloneNode(true);
        sectionNode.querySelector('[data-picker-section-title]').textContent = LABELS[key];
        const grid = sectionNode.querySelector('[data-picker-section-grid]');
        for (const p of items) {
          const perkNode = perkTemplate.content.firstElementChild.cloneNode(true);
          perkNode.dataset.perkHash = p.hash;
          const icon = perkNode.querySelector('[data-picker-perk-icon]');
          icon.src = '/destiny/api/icon?type=perk&hash=' + encodeURIComponent(p.hash);
          icon.alt = '';
          perkNode.querySelector('[data-picker-perk-name]').textContent = p.name;
          perkNode.title = p.description || p.name;
          perkNode.addEventListener('click', () => togglePerk(p.hash));
          grid.appendChild(perkNode);
        }
        sectionsEl.appendChild(sectionNode);
      }
      if (!rendered) emptyEl.hidden = false;
    }

    function togglePerk(hash) {
      const idx = selected.indexOf(hash);
      if (idx >= 0) {
        selected.splice(idx, 1);
      } else if (selected.length < 2) {
        selected.push(hash);
      } else {
        selected.shift();
        selected.push(hash);
      }
      refreshSelection();
    }

    function refreshSelection() {
      const set = new Set(selected);
      let count = 0;
      dialog.querySelectorAll('[data-picker-perk]').forEach((node) => {
        const isSelected = set.has(node.dataset.perkHash);
        node.dataset.selected = isSelected ? '1' : '';
        if (isSelected) count++;
      });
      const slots = Array.from({ length: 2 }, (_, i) => {
        const h = selected[i];
        if (!h) return '· vacío';
        const node = dialog.querySelector('[data-picker-perk][data-perk-hash="' + h + '"] [data-picker-perk-name]');
        return node?.textContent || '·';
      });
      statusEl.textContent =
        count === 0
          ? 'Elegí 2 perks para tu wishlist.'
          : 'Slot 1: ' + escapeHtml(slots[0]) + ' · Slot 2: ' + escapeHtml(slots[1]);
      confirmBtn.disabled = count !== 2;
    }

    function resetState() {
      selected = [];
      currentItemHash = null;
      currentOnAdded = null;
      sectionsEl.innerHTML = '';
      emptyEl.hidden = true;
      weaponIcon.removeAttribute('src');
      weaponName.textContent = 'Seleccioná perks';
      weaponMeta.textContent = '';
      statusEl.textContent = 'Elegí 2 perks para tu wishlist.';
      confirmBtn.disabled = true;
    }

    async function fetchPerks(hash) {
      const res = await fetch('/destiny/api/weapon-perks?hash=' + encodeURIComponent(hash));
      if (!res.ok) {
        if (res.status === 401) {
          statusEl.textContent = 'Sesión expirada. Recargá la página.';
          return null;
        }
        statusEl.textContent = 'No se pudo cargar las perks del arma.';
        return null;
      }
      const data = await res.json();
      if (data.error) {
        statusEl.textContent = data.message || 'No se pudo cargar las perks del arma.';
        return null;
      }
      return data;
    }

    window.openPerkPicker = async function openPerkPicker(itemHash, onAdded) {
      resetState();
      currentItemHash = itemHash;
      currentOnAdded = onAdded || null;
      const data = await fetchPerks(itemHash);
      if (!data) {
        return;
      }
      weaponIcon.src = '/destiny/api/icon?type=weapon&hash=' + encodeURIComponent(data.weapon.hash);
      weaponIcon.alt = data.weapon.name;
      weaponName.textContent = data.weapon.name;
      const meta = [];
      if (data.weapon.tier === 'exotic') meta.push('Exotic');
      if (data.weapon.damage) meta.push(data.weapon.damage);
      weaponMeta.textContent = meta.join(' · ');
      renderPerks(data.perks);
      refreshSelection();
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
    };

    function closePicker() {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
    }

    async function confirmAdd() {
      if (!currentItemHash || selected.length !== 2) return;
      confirmBtn.disabled = true;
      cancelBtn.disabled = true;
      const originalText = confirmBtn.textContent;
      confirmBtn.textContent = 'Agregando…';
      try {
        const res = await fetch('/destiny/api/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ itemHash: currentItemHash, perkHashes: selected }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          if (res.status === 409) {
            statusEl.textContent = 'Ya está en tu wishlist.';
          } else if (res.status === 400) {
            statusEl.textContent = data.message || 'Perks inválidas.';
          } else if (res.status === 401) {
            statusEl.textContent = 'Sesión expirada. Recargá la página.';
          } else if (res.status === 404) {
            statusEl.textContent = 'Arma no encontrada.';
          } else {
            statusEl.textContent = data.message || 'Error al agregar.';
          }
          confirmBtn.disabled = false;
          cancelBtn.disabled = false;
          confirmBtn.textContent = originalText;
          return;
        }
        const data = await res.json();
        const cb = currentOnAdded;
        closePicker();
        if (typeof cb === 'function') cb(data.weapon);
      } catch {
        statusEl.textContent = 'Error de red. Probá de nuevo.';
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
        confirmBtn.textContent = originalText;
      }
    }

    confirmBtn.addEventListener('click', confirmAdd);
    cancelBtn.addEventListener('click', closePicker);
    closeBtn.addEventListener('click', closePicker);
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const inside =
        e.clientX >= rect.left &&
        e.clientX <= rect.right &&
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom;
      if (!inside) closePicker();
    });
  })();
</script>
