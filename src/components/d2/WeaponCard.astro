---
import type { PerkSlot } from '../../lib/d2/wishlist';

interface PerkLite {
  hash: string;
  name: string;
  icon: string;
  category: string;
  isCustom?: boolean;
}

interface Props {
  itemHash: string;
  name: string;
  iconPath: string;
  tier?: 'exotic' | 'legendary';
  perks: Partial<Record<PerkSlot, PerkLite | null>>;
  weaponType?: string;
  found: boolean;
  foundAt: number | null;
}

const SLOT_ORDER: PerkSlot[] = ['barrel', 'magazine', 'perk1', 'perk2'];
const SLOT_LABELS: Record<PerkSlot, string> = {
  barrel: 'Cañón',
  magazine: 'Cargador',
  perk1: 'Rasgo 1',
  perk2: 'Rasgo 2',
};

const { itemHash, name, iconPath, tier, perks, weaponType, found, foundAt } = Astro.props;

const weaponIconUrl = `/destiny/api/icon?type=weapon&hash=${itemHash}`;
const emptyIconUrl =
  "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23e4e4e7'/><text x='50%' y='58%' font-size='14' text-anchor='middle' fill='%2371717a' font-family='sans-serif'>?</text></svg>";

const foundDateLabel = foundAt
  ? new Date(foundAt).toLocaleDateString('es', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
---

<article
  class:list={[
    'group relative flex flex-col gap-3 rounded-2xl border bg-white p-5 transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur',
    found
      ? 'border-zinc-200 opacity-60 dark:border-white/10'
      : 'border-zinc-200 hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-lg dark:border-white/10 dark:hover:border-white/25 dark:hover:bg-white/[0.04]',
  ]}
  data-weapon-card
  data-found={found ? '1' : '0'}
  data-item-hash={itemHash}
  data-weapon-type={weaponType ?? ''}
  data-search={name.toLowerCase()}
>
  {
    found && (
      <span
        class="absolute left-3 top-3 grid h-6 w-6 place-items-center rounded-full bg-emerald-500 text-xs font-semibold text-white"
        title={`Encontrada el ${foundDateLabel}`}
        aria-label="Encontrada"
      >
        ✓
      </span>
    )
  }

  <div class="flex items-center justify-center">
    <div class="flex h-28 w-28 items-center justify-center overflow-hidden rounded-lg bg-zinc-100 dark:bg-white/[0.04]">
      <img
        src={weaponIconUrl}
        alt={name}
        loading="lazy"
        class="h-24 w-24 object-contain"
        style="image-rendering: -webkit-optimize-contrast;"
      />
    </div>
  </div>

  <h3
    class:list={[
      'font-semibold text-zinc-900 dark:text-white',
      found && 'line-through',
    ]}
  >
    {name}
  </h3>
  {weaponType && (
    <p class="text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
      {weaponType}
    </p>
  )}
  {tier && (
    <span
      class="w-fit rounded-full border border-zinc-200 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:border-white/10 dark:text-zinc-400"
      data-tier-badge
    >
      {tier === 'exotic' ? 'Exótico' : 'Legendario'}
    </span>
  )}

  <div class="flex flex-col gap-1.5">
    {
    SLOT_ORDER.map((slot) => {
      const perk = perks[slot];
      if (!perk || !perk.name) return null;
      let iconUrl = emptyIconUrl;
      if (perk.icon) {
        // Custom icons may be external URLs (R2/Bungie/external).
        // Built-in perks use the icon proxy endpoint that caches in R2.
        iconUrl =
          perk.hash && perk.icon.startsWith('/')
            ? `/destiny/api/icon?type=perk&hash=${encodeURIComponent(perk.hash)}`
            : perk.icon;
      }
      return (
          <div class="flex items-center gap-2" data-perk-row data-slot={slot}>
            <img
              src={iconUrl}
              alt={perk.name}
              title={perk.name}
              loading="lazy"
              class="h-8 w-8 shrink-0 rounded ring-1 ring-zinc-200 dark:ring-white/10"
            />
            <span class="flex-1 truncate text-xs text-zinc-600 dark:text-zinc-300">
              <span class="font-medium uppercase tracking-wider text-[10px] text-zinc-400 dark:text-zinc-500 mr-1">
                {SLOT_LABELS[slot]}
              </span>
              {perk.name}
            </span>
          </div>
        );
      })
    }
  </div>

  <div class="mt-auto flex items-center justify-between gap-2 pt-1">
    <button
      type="button"
      class="text-xs uppercase tracking-wider transition data-[found=true]:text-emerald-600 data-[found=false]:text-zinc-500 hover:text-zinc-900 dark:data-[found=true]:text-emerald-400 dark:data-[found=false]:text-zinc-500 dark:hover:text-white"
      data-toggle-found
      data-item-hash={itemHash}
      data-found={found ? 'true' : 'false'}
    >
      {found ? 'Marcar pendiente' : 'Marcar encontrada'}
    </button>
    <div class="flex items-center gap-3">
      <button
        type="button"
        class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white"
        data-edit-weapon
        data-item-hash={itemHash}
        title="Editar perks"
        aria-label="Editar perks"
      >
        editar
      </button>
      <button
        type="button"
        class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-red-500 dark:text-zinc-500 dark:hover:text-red-400"
        data-remove-weapon
        data-item-hash={itemHash}
        title="Quitar de la wishlist"
        aria-label="Quitar"
      >
        ×
      </button>
    </div>
  </div>
</article>
