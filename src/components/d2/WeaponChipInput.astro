---
---
<div class="relative" data-chip-input-wrapper>
  <input
    type="text"
    name="weapon-query"
    placeholder="Buscar arma por nombre (ej. Fatebringer, Mountaintop…)"
    autocomplete="off"
    spellcheck="false"
    autocapitalize="off"
    autocorrect="off"
    class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
    data-weapon-input
    aria-autocomplete="list"
    aria-controls="d2-weapon-suggestions"
    aria-expanded="false"
  />
  <ul
    id="d2-weapon-suggestions"
    role="listbox"
    class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-zinc-200 bg-white shadow-lg dark:border-white/10 dark:bg-zinc-900"
    data-weapon-suggestions
  ></ul>
</div>

<template data-weapon-suggestion-template>
  <li
    role="option"
    tabindex="0"
    class="flex cursor-pointer items-center gap-3 px-3 py-2 text-sm text-zinc-900 hover:bg-zinc-100 dark:text-white dark:hover:bg-white/10"
    data-suggestion
  >
    <img
      alt=""
      class="h-6 w-6 object-contain"
      data-suggestion-icon
    />
    <span data-suggestion-name class="flex-1"></span>
    <span
      class="text-[10px] font-medium uppercase tracking-wider text-zinc-500"
      data-suggestion-meta
    ></span>
  </li>
</template>

<script is:inline>
  (function () {
    const wrapper = document.querySelector('[data-chip-input-wrapper]');
    if (!wrapper) return;
    const input = wrapper.querySelector('[data-weapon-input]');
    const list = wrapper.querySelector('[data-weapon-suggestions]');
    const template = document.querySelector('[data-weapon-suggestion-template]');
    if (!input || !list || !template) return;

    let debounce;
    let activeIndex = -1;
    let results = [];

    function closeList() {
      list.innerHTML = '';
      list.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
      results = [];
    }

    function render(items) {
      list.innerHTML = '';
      if (!items.length) {
        list.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }
      for (const w of items) {
        const node = template.content.firstElementChild.cloneNode(true);
        node.dataset.itemHash = w.hash;
        node.dataset.weaponName = w.name;
        const icon = node.querySelector('[data-suggestion-icon]');
        if (icon) {
          icon.src = '/destiny/api/icon?type=weapon&hash=' + w.hash;
          icon.alt = '';
        }
        node.querySelector('[data-suggestion-name]').textContent = w.name;
        const meta = node.querySelector('[data-suggestion-meta]');
        meta.textContent = w.tier === 'exotic' ? 'exotic' : (w.damage || '');
        list.appendChild(node);
      }
      list.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
      activeIndex = -1;
      results = items;
    }

    async function fetchSuggestions(q) {
      try {
        const res = await fetch('/destiny/api/search?q=' + encodeURIComponent(q));
        if (!res.ok) return [];
        const data = await res.json();
        return data.results || [];
      } catch {
        return [];
      }
    }

    input.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = input.value.trim();
      if (q.length < 2) {
        closeList();
        return;
      }
      debounce = setTimeout(async () => {
        const items = await fetchSuggestions(q);
        render(items);
      }, 150);
    });

    input.addEventListener('keydown', (e) => {
      const items = list.querySelectorAll('[data-suggestion]');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (!items.length) return;
        activeIndex = (activeIndex + 1) % items.length;
        items.forEach((el, i) => el.classList.toggle('bg-zinc-100', i === activeIndex));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (!items.length) return;
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        items.forEach((el, i) => el.classList.toggle('bg-zinc-100', i === activeIndex));
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && results[activeIndex]) {
          e.preventDefault();
          pick(results[activeIndex]);
        }
      } else if (e.key === 'Escape') {
        closeList();
      }
    });

    list.addEventListener('click', (e) => {
      const li = e.target.closest('[data-suggestion]');
      if (!li) return;
      const itemHash = li.dataset.itemHash;
      const weaponName = li.dataset.weaponName;
      pick({ hash: itemHash, name: weaponName });
    });

    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target)) closeList();
    });

    async function pick(weapon) {
      closeList();
      input.value = '';
      try {
        const res = await fetch('/destiny/api/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ itemHash: weapon.hash }),
        });
        if (!res.ok) {
          if (res.status === 409) {
            showFlash('Ya está en tu wishlist.', 'info');
            return;
          }
          if (res.status === 422) {
            const data = await res.json().catch(() => ({}));
            showFlash(data.message || 'Esta arma no tiene perks disponibles.', 'error');
            return;
          }
          if (res.status === 401) {
            showFlash('Sesión expirada. Recargá la página.', 'error');
            return;
          }
          throw new Error('add failed');
        }
        const data = await res.json();
        const grid = document.querySelector('[data-weapons-grid]');
        const empty = document.querySelector('[data-empty-state]');
        if (grid && data.weapon) {
          const node = buildCard(data.weapon);
          grid.prepend(node);
        }
        if (empty && empty.dataset.scope === 'all') {
          empty.classList.add('hidden');
        }
        if (typeof window.updateFilterCounts === 'function') window.updateFilterCounts();
        if (typeof window.applyFilter === 'function') window.applyFilter(window.currentFilter || 'pending');
        showFlash('Agregada a tu wishlist.', 'success');
      } catch (err) {
        showFlash('Error al agregar. Probá de nuevo.', 'error');
      }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[c]);
    }

    function buildCard(w) {
      const el = document.createElement('article');
      el.dataset.weaponCard = '';
      el.dataset.found = w.found ? '1' : '0';
      el.dataset.itemHash = w.itemHash;
      el.className =
        'group relative flex flex-col gap-3 rounded-2xl border border-zinc-200 bg-white p-5 transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur';
      el.innerHTML = `
        <div class="flex items-center justify-center">
          <div class="flex h-28 w-28 items-center justify-center overflow-hidden rounded-lg bg-zinc-100 dark:bg-white/[0.04]">
            <img src="/destiny/api/icon?type=weapon&hash=${encodeURIComponent(w.itemHash)}" alt="${escapeHtml(w.name)}" loading="lazy" class="h-24 w-24 object-contain" style="image-rendering: -webkit-optimize-contrast;" />
          </div>
        </div>
        <h3 class="font-semibold text-zinc-900 dark:text-white">${escapeHtml(w.name)}</h3>
        <div class="flex items-center gap-2">
          <img src="/destiny/api/icon?type=perk&hash=${encodeURIComponent(w.perk1.hash)}" alt="${escapeHtml(w.perk1.name)}" title="${escapeHtml(w.perk1.name)}" loading="lazy" class="h-10 w-10 rounded ring-1 ring-zinc-200 dark:ring-white/10" />
          <img src="/destiny/api/icon?type=perk&hash=${encodeURIComponent(w.perk2.hash)}" alt="${escapeHtml(w.perk2.name)}" title="${escapeHtml(w.perk2.name)}" loading="lazy" class="h-10 w-10 rounded ring-1 ring-zinc-200 dark:ring-white/10" />
        </div>
        <div class="mt-auto flex items-center justify-between gap-2 pt-1">
          <button type="button" data-toggle-found data-item-hash="${escapeHtml(w.itemHash)}" data-found="false" class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white">Marcar encontrada</button>
          <button type="button" data-remove-weapon data-item-hash="${escapeHtml(w.itemHash)}" title="Quitar de la wishlist" aria-label="Quitar" class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-red-500 dark:text-zinc-500 dark:hover:text-red-400">×</button>
        </div>
      `;
      return el;
    }

    function showFlash(msg, kind) {
      const existing = document.querySelector('[data-flash]');
      if (existing) existing.remove();
      const div = document.createElement('div');
      div.dataset.flash = '1';
      const tone =
        kind === 'error'
          ? 'border-red-500/30 bg-red-500/10 text-red-600 dark:text-red-400'
          : kind === 'info'
            ? 'border-zinc-300 bg-zinc-100 text-zinc-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-200'
            : 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400';
      div.className =
        'mt-2 rounded-lg border px-3 py-2 text-sm transition ' + tone;
      div.textContent = msg;
      wrapper.appendChild(div);
      setTimeout(() => div.remove(), 2500);
    }
  })();
</script>
