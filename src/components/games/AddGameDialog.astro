---
---

<button
  type="button"
  class="fixed bottom-4 right-4 z-30 inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-900 shadow-md transition hover:-translate-y-0.5 hover:shadow-lg dark:border-white/10 dark:bg-zinc-800 dark:text-white"
  data-add-game-chip
  aria-label="Agregar juego"
>
  <span class="text-sm leading-none">+</span>
  <span>Agregar juego</span>
</button>

<dialog
  class="backdrop:bg-zinc-900/95 dark:bg-zinc-950/95 m-auto max-h-[90vh] w-[min(560px,calc(100vw-2rem))] overflow-y-auto overscroll-contain rounded-2xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-2xl dark:border-white/10 dark:bg-zinc-900 dark:text-white"
  data-add-dialog
>
  <header class="flex items-center gap-3 border-b border-zinc-200 p-4 dark:border-white/10">
    <div class="min-w-0 flex-1">
      <h2 class="truncate font-semibold">Agregar juego</h2>
      <p class="text-xs uppercase tracking-wider text-zinc-500">Desde Steam o manual</p>
    </div>
    <button
      type="button"
      class="grid h-8 w-8 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
      data-add-close
      aria-label="Cerrar"
    >
      ×
    </button>
  </header>

  <div class="p-4">
    <div
      class="mb-3 inline-flex rounded-lg border border-zinc-200 p-1 dark:border-white/10"
      data-mode-tabs
      role="tablist"
      aria-label="Cómo agregar el juego"
    >
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-mode-tab="steam"
        class="rounded-md px-3 py-1.5 text-xs font-medium uppercase tracking-wider transition"
      >
        Buscar en Steam
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-mode-tab="manual"
        class="rounded-md px-3 py-1.5 text-xs font-medium uppercase tracking-wider transition"
      >
        Agregar manual
      </button>
    </div>

    <div data-panel="steam">
      <input
        type="text"
        placeholder="Buscar juego (ej. Balatro, Elden Ring…)"
        autocomplete="off"
        spellcheck="false"
        autocapitalize="off"
        autocorrect="off"
        class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
        data-add-input
      />

      <div
        class="mt-3 hidden max-h-[60vh] overflow-y-auto overscroll-contain rounded-lg border border-zinc-200 dark:border-white/10"
        data-add-results
        role="listbox"
      ></div>

      <p
        class="mt-3 hidden rounded-lg border border-dashed border-zinc-300 p-3 text-center text-sm text-zinc-500 dark:border-white/10"
        data-add-empty
      >
        Sin coincidencias en Steam. Probá con otro nombre o usá "Agregar manual".
      </p>
    </div>

    <form class="hidden flex-col gap-3" data-manual-form data-panel="manual" novalidate>
      <label class="block">
        <span class="text-xs font-medium uppercase tracking-wider text-zinc-500">Nombre</span>
        <input
          type="text"
          name="name"
          placeholder="Ej. Stella Sora"
          autocomplete="off"
          spellcheck="false"
          required
          maxlength="80"
          class="mt-1.5 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
          data-manual-name
        />
      </label>

      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-xs font-medium uppercase tracking-wider text-zinc-500">Año (opcional)</span>
          <input
            type="number"
            name="year"
            inputmode="numeric"
            min="1900"
            max="2100"
            placeholder="2024"
            class="mt-1.5 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
            data-manual-year
          />
        </label>
        <label class="block">
          <span class="text-xs font-medium uppercase tracking-wider text-zinc-500">Portada URL (opcional)</span>
          <input
            type="url"
            name="coverUrl"
            placeholder="https://…"
            autocomplete="off"
            spellcheck="false"
            class="mt-1.5 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-zinc-500 dark:focus:border-white/30"
            data-manual-cover
          />
        </label>
      </div>

      <button
        type="submit"
        class="mt-1 w-full rounded-lg bg-zinc-900 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
        data-manual-submit
      >
        Agregar juego
      </button>
    </form>

    <p
      class="mt-3 hidden rounded-lg border border-emerald-500/40 bg-emerald-500/10 p-3 text-center text-sm text-emerald-700 dark:text-emerald-400"
      data-add-success
    >
      Agregado ✓
    </p>

    <p
      class="mt-3 hidden rounded-lg border border-red-500/40 bg-red-500/10 p-3 text-center text-sm text-red-600 dark:text-red-400"
      data-add-error
    ></p>
  </div>
</dialog>

<script>
  // No usamos innerHTML para los results — construimos cada <button> con
  // createElement/setAttribute/textContent (mismo patrón que AddCharacterDialog).

  const dialog = document.querySelector("[data-add-dialog]");
  const chip = document.querySelector("[data-add-game-chip]");
  const input = document.querySelector("[data-add-input]");
  const resultsEl = document.querySelector("[data-add-results]");
  const emptyEl = document.querySelector("[data-add-empty]");
  const successEl = document.querySelector("[data-add-success]");
  const errorEl = document.querySelector("[data-add-error]");
  const closeBtn = document.querySelector("[data-add-close]");

  const modeTabs = document.querySelector("[data-mode-tabs]");
  const panels = document.querySelectorAll("[data-panel]");
  const manualForm = document.querySelector("[data-manual-form]");
  const manualName = document.querySelector("[data-manual-name]");
  const manualYear = document.querySelector("[data-manual-year]");
  const manualCover = document.querySelector("[data-manual-cover]");
  const manualSubmit = document.querySelector("[data-manual-submit]");

  const TAB_ACTIVE = [
    "border-transparent",
    "bg-zinc-900",
    "text-white",
    "dark:bg-white",
    "dark:text-zinc-900",
  ];
  const TAB_INACTIVE = [
    "text-zinc-500",
    "hover:text-zinc-900",
    "dark:text-zinc-500",
    "dark:hover:text-white",
  ];

  let bodyLocked = false;
  let submitting = false;
  let currentMode = "steam";

  function lockBodyScroll() {
    if (bodyLocked) return;
    bodyLocked = true;
    const sbw = window.innerWidth - document.documentElement.clientWidth;
    document.body.style.overflow = "hidden";
    if (sbw > 0) document.body.style.paddingRight = sbw + "px";
  }
  function unlockBodyScroll() {
    if (!bodyLocked) return;
    bodyLocked = false;
    document.body.style.overflow = "";
    document.body.style.paddingRight = "";
  }

  function setMode(mode) {
    currentMode = mode;
    if (modeTabs) {
      modeTabs.querySelectorAll("[data-mode-tab]").forEach((tab) => {
        const active = tab.dataset.modeTab === mode;
        tab.setAttribute("aria-selected", active ? "true" : "false");
        for (const c of TAB_ACTIVE) tab.classList.toggle(c, active);
        for (const c of TAB_INACTIVE) tab.classList.toggle(c, !active);
      });
    }
    panels.forEach((panel) => {
      const show = panel.dataset.panel === mode;
      panel.classList.toggle("hidden", !show);
      if (mode === "manual" && show) {
        panel.classList.remove("hidden");
        panel.classList.add("flex");
      }
    });
    if (mode === "steam") setTimeout(() => input?.focus(), 0);
    if (mode === "manual") setTimeout(() => manualName?.focus(), 0);
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.remove("hidden");
  }
  function hideStatus() {
    successEl.classList.add("hidden");
    errorEl.classList.add("hidden");
  }

  function openDialog() {
    if (!dialog) return;
    hideStatus();
    input.value = "";
    resultsEl.replaceChildren();
    resultsEl.classList.add("hidden");
    emptyEl.classList.add("hidden");
    manualName.value = "";
    manualYear.value = "";
    manualCover.value = "";
    setMode(currentMode);
    lockBodyScroll();
    dialog.showModal();
  }

  function closeDialog() {
    if (!dialog) return;
    dialog.close();
    unlockBodyScroll();
  }

  chip?.addEventListener("click", openDialog);
  closeBtn?.addEventListener("click", closeDialog);
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) closeDialog();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && dialog?.open) closeDialog();
  });
  modeTabs?.addEventListener("click", (e) => {
    const tab = e.target.closest("[data-mode-tab]");
    if (tab && tab.dataset.modeTab !== currentMode) {
      hideStatus();
      setMode(tab.dataset.modeTab);
    }
  });

  function buildResultButton(r) {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.dataset.pickGame = "";
    btn.dataset.appId = String(r.appId ?? "");
    btn.className =
      "flex w-full cursor-pointer items-center gap-3 border-b border-zinc-200 p-3 text-left transition last:border-b-0 hover:bg-zinc-100 dark:border-white/10 dark:hover:bg-white/[0.06]";

    if (r.tinyImage) {
      const img = document.createElement("img");
      img.src = r.tinyImage;
      img.alt = r.name ?? "";
      img.loading = "lazy";
      img.className = "h-10 w-auto shrink-0 rounded bg-zinc-100 object-cover dark:bg-white/[0.02]";
      btn.appendChild(img);
    }

    const text = document.createElement("div");
    text.className = "min-w-0 flex-1";
    const nameDiv = document.createElement("div");
    nameDiv.className = "truncate font-medium";
    nameDiv.textContent = r.name ?? "";
    text.appendChild(nameDiv);
    btn.appendChild(text);

    const action = document.createElement("span");
    action.className = "text-xs uppercase tracking-wider text-zinc-500";
    action.textContent = "agregar →";
    btn.appendChild(action);

    return btn;
  }

  let searchAbort = null;
  let searchSeq = 0;

  async function runSearch(query) {
    const seq = ++searchSeq;
    if (query.length < 2) {
      resultsEl.replaceChildren();
      resultsEl.classList.add("hidden");
      emptyEl.classList.add("hidden");
      return;
    }
    try {
      if (searchAbort) searchAbort.abort();
      searchAbort = new AbortController();
      const res = await fetch("/games/api/search?q=" + encodeURIComponent(query), {
        signal: searchAbort.signal,
      });
      const data = await res.json();
      if (seq !== searchSeq) return;
      const results = data.results || [];
      if (results.length === 0) {
        resultsEl.replaceChildren();
        resultsEl.classList.add("hidden");
        emptyEl.classList.remove("hidden");
        return;
      }
      emptyEl.classList.add("hidden");
      resultsEl.classList.remove("hidden");
      const frag = document.createDocumentFragment();
      for (const r of results) frag.appendChild(buildResultButton(r));
      resultsEl.replaceChildren(frag);
    } catch (err) {
      if (err.name !== "AbortError") console.error(err);
    }
  }

  let debounce;
  input?.addEventListener("input", (e) => {
    clearTimeout(debounce);
    debounce = setTimeout(() => runSearch(e.target.value.trim()), 250);
  });

  resultsEl?.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-pick-game]");
    if (!btn || btn.disabled) return;
    const appId = Number(btn.dataset.appId);
    if (!appId) return;
    btn.disabled = true;
    btn.classList.add("opacity-50", "pointer-events-none");
    hideStatus();
    try {
      const res = await fetch("/games/api/add", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ appId }),
      });
      if (res.status === 409) {
        showError("Ese juego ya está en tu lista");
        btn.disabled = false;
        btn.classList.remove("opacity-50", "pointer-events-none");
        return;
      }
      if (!res.ok) {
        let msg = "Error " + res.status;
        try {
          const body = await res.json();
          if (body && body.error) msg = "Error " + res.status + ": " + body.error;
        } catch {}
        showError(msg);
        btn.disabled = false;
        btn.classList.remove("opacity-50", "pointer-events-none");
        return;
      }
      const data = await res.json();
      successEl.classList.remove("hidden");
      setTimeout(() => closeDialog(), 350);
      window.dispatchEvent(
        new CustomEvent("games:game-added", { detail: { game: data.game } })
      );
    } catch (err) {
      showError("Error de red");
      btn.disabled = false;
      btn.classList.remove("opacity-50", "pointer-events-none");
    }
  });

  manualForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (submitting) return;
    hideStatus();

    const name = manualName.value.trim();
    if (!name) {
      showError("Poné un nombre");
      manualName.focus();
      return;
    }
    const yearRaw = manualYear.value.trim();
    const year = yearRaw ? Number(yearRaw) : null;
    if (year !== null && (!Number.isInteger(year) || year < 1900 || year > 2100)) {
      showError("Año inválido (1900-2100)");
      manualYear.focus();
      return;
    }
    const coverUrl = manualCover.value.trim() || null;
    if (coverUrl && !/^https?:\/\//i.test(coverUrl)) {
      showError("URL de portada inválida (debe empezar con http:// o https://)");
      manualCover.focus();
      return;
    }

    submitting = true;
    manualSubmit.disabled = true;
    try {
      const res = await fetch("/games/api/add-manual", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, year, coverUrl }),
      });
      if (res.status === 409) {
        showError("Ese juego ya está en tu lista");
        submitting = false;
        manualSubmit.disabled = false;
        return;
      }
      if (!res.ok) {
        let msg = "Error " + res.status;
        try {
          const body = await res.json();
          if (body && body.error) msg = "Error " + res.status + ": " + body.error;
        } catch {}
        showError(msg);
        submitting = false;
        manualSubmit.disabled = false;
        return;
      }
      const data = await res.json();
      successEl.classList.remove("hidden");
      setTimeout(() => closeDialog(), 350);
      window.dispatchEvent(
        new CustomEvent("games:game-added", { detail: { game: data.game } })
      );
    } catch (err) {
      showError("Error de red");
    } finally {
      submitting = false;
      manualSubmit.disabled = false;
    }
  });
</script>
