<dialog
  class="backdrop:bg-zinc-900/95 dark:bg-zinc-950/95 m-auto max-h-[90vh] w-[min(440px,calc(100vw-2rem))] overflow-y-auto overscroll-contain rounded-2xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-2xl dark:border-white/10 dark:bg-zinc-900 dark:text-white"
  data-random-dialog
>
  <header class="flex items-center gap-3 border-b border-zinc-200 p-4 dark:border-white/10">
    <div class="min-w-0 flex-1">
      <h2 class="truncate font-semibold">Random pick</h2>
      <p class="text-xs uppercase tracking-wider text-zinc-500">Tu próximo juego</p>
    </div>
    <button
      type="button"
      class="grid h-8 w-8 place-items-center rounded-full text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/10 dark:hover:text-white"
      data-random-close
      aria-label="Cerrar"
    >
      ×
    </button>
  </header>

  <div class="p-4">
    <div class="overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800">
      <img
        src=""
        alt=""
        class="hidden aspect-[460/215] h-full w-full object-cover"
        data-random-cover
      />
      <div
        class="grid aspect-[460/215] place-items-center bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-white/[0.04] dark:to-white/[0.06]"
        data-random-fallback
        aria-hidden="true"
      >
        <span class="text-4xl font-bold tracking-wide text-zinc-300 dark:text-zinc-600" data-random-initials>?</span>
      </div>
    </div>

    <div class="mt-4 text-center">
      <h3 class="text-xl font-semibold text-zinc-900 dark:text-white" data-random-title></h3>
      <p class="mt-1 text-sm text-zinc-500" data-random-meta></p>
      <p class="mt-1 hidden text-sm text-zinc-500" data-random-saga></p>
    </div>

    <p
      class="mt-4 hidden rounded-lg border border-red-500/40 bg-red-500/10 p-3 text-center text-sm text-red-600 dark:text-red-400"
      data-random-error
      role="alert"
    ></p>
  </div>

  <footer class="flex items-center justify-end gap-3 border-t border-zinc-200 p-4 dark:border-white/10">
    <button
      type="button"
      class="rounded-lg border border-zinc-200 px-3 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:border-white/10 dark:text-zinc-200 dark:hover:bg-white/10"
      data-random-close
    >
      Cerrar
    </button>
    <button
      type="button"
      class="rounded-lg bg-zinc-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-zinc-700 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
      data-random-start
    >
      Marcar como jugando
    </button>
  </footer>
</dialog>
