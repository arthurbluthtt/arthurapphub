---
import { STATUS_LABELS, type MangaRow } from '../../lib/manga/store';

interface Props {
  item: MangaRow;
}

const { item } = Astro.props;

const typeIcon = item.mangaType === 'manhwa' ? '🇰🇷' : item.mangaType === 'manhua' ? '🇨🇳' : '📚';
const typeLabel = item.mangaType === 'manhwa' ? 'Manhwa' : item.mangaType === 'manhua' ? 'Manhua' : 'Manga';
---

<article
  data-manga-card
  data-manga-id={item.id}
  data-status={item.status}
  data-manga-type={item.mangaType}
  data-search={item.title.toLowerCase()}
  class="w-full overflow-hidden rounded-2xl border border-zinc-200 bg-white transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur"
>
  <div class="relative aspect-[2/3] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
    {item.coverUrl ? (
      <img
        data-manga-cover-image
        src={item.coverUrl}
        alt={item.title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="grid h-full w-full place-items-center bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-white/[0.04] dark:to-white/[0.06]">
        <span class="text-xl font-bold tracking-wide text-zinc-300 dark:text-zinc-600">
          {item.title.split(/\s+/).slice(0, 2).map((w) => w[0] || '').join('').toUpperCase()}
        </span>
      </div>
    )}
    <span class="absolute left-1.5 top-1.5 rounded-full bg-zinc-950/70 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-white backdrop-blur">
      {typeIcon} {typeLabel}
    </span>
  </div>
  <div class="flex flex-col gap-1 p-1.5">
    <h3 class="truncate font-semibold text-zinc-900 dark:text-white">{item.title}</h3>
    <div class="flex items-center gap-1">
      <button
        type="button"
        data-status-button
        data-manga-id={item.id}
        data-status={item.status}
        aria-haspopup="listbox"
        aria-expanded="false"
        class="flex flex-1 items-center justify-between gap-2 rounded-lg border border-zinc-300 bg-white px-2.5 py-1 text-xs font-medium text-zinc-700 outline-none transition hover:border-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-200 dark:hover:border-white/30 dark:focus:border-white/30"
      >
        <span data-status-label class="truncate">{STATUS_LABELS[item.status]}</span>
        <span aria-hidden="true" class="shrink-0 text-[10px] text-zinc-400 dark:text-zinc-500">▾</span>
      </button>
      <button
        type="button"
        data-edit-button
        data-manga-id={item.id}
        aria-label="Editar"
        title="Editar"
        class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-zinc-200 hover:text-zinc-700 dark:text-zinc-500 dark:hover:bg-white/10 dark:hover:text-zinc-200"
      >
        <span aria-hidden="true" class="text-xs">✎</span>
      </button>
      <button
        type="button"
        data-remove-button
        data-manga-id={item.id}
        aria-label="Eliminar"
        title="Eliminar"
        class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-zinc-200 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-white/10 dark:hover:text-red-400"
      >
        <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 4h10M6 4V2.5h4V4M5 4l1 9h4l1-9" />
        </svg>
      </button>
    </div>
  </div>
</article>
