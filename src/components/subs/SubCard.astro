---
import type { SubRow } from '../../lib/subs/store';
import { formatPrice } from '../../lib/subs/format';

interface Props {
  sub: SubRow;
}

const { sub } = Astro.props;
---

<article
  data-sub-card
  data-sub-id={sub.id}
  data-search={sub.name.toLowerCase()}
  class="flex flex-col gap-3 rounded-2xl border border-zinc-200 bg-white p-5 transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h3 class="truncate font-semibold text-zinc-900 dark:text-white">{sub.name}</h3>
      <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-500">
        Se cobra el día {sub.billingDay}
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <span
        class="text-lg font-semibold tabular-nums text-zinc-900 dark:text-white"
        data-sub-price
      >
        {formatPrice(sub.priceCents, sub.currency)}
      </span>
      <button
        type="button"
        data-edit-sub
        data-sub-id={sub.id}
        title="Editar suscripción"
        aria-label="Editar"
        class="grid h-7 w-7 place-items-center rounded-full text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-500 dark:hover:bg-white/10 dark:hover:text-white"
      >
        ✎
      </button>
      <button
        type="button"
        data-remove-sub
        data-sub-id={sub.id}
        title="Eliminar suscripción"
        aria-label="Eliminar"
        class="grid h-7 w-7 place-items-center rounded-full text-zinc-400 transition hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-red-500/10 dark:hover:text-red-400"
      >
        ×
      </button>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <span
      class="rounded-full border border-zinc-200 px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-zinc-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-200"
      data-sub-currency
    >
      {sub.currency}
    </span>
    <button
      type="button"
      data-toggle-active
      data-sub-id={sub.id}
      class={[
        'rounded-full border px-3 py-1.5 text-xs font-medium uppercase tracking-wider transition',
        sub.active
          ? 'border-transparent bg-zinc-900 text-white dark:bg-white dark:text-zinc-900'
          : 'border-zinc-300 text-zinc-500 hover:border-zinc-400 dark:border-white/15 dark:text-zinc-400 dark:hover:border-white/30',
      ].join(' ')}
    >
      {sub.active ? 'Activa' : 'Pausada'}
    </button>
  </div>
</article>
