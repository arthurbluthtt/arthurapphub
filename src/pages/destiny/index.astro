---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeaponCard from '../../components/d2/WeaponCard.astro';
import AddWeaponDialog from '../../components/d2/AddWeaponDialog.astro';
import { lookupSession, readCookie } from '../../lib/auth';
import { listWishlist } from '../../lib/d2/wishlist';
import { resolveWishlistRow } from '../../lib/d2/resolver';

export const prerender = false;

const sessionId = readCookie(Astro.request);
const sess = sessionId ? await lookupSession(env.AUTH_DB, sessionId) : null;
if (!sess) {
  return Astro.redirect('/?next=' + encodeURIComponent('/destiny'));
}

type Filter = 'pending' | 'found' | 'all';
const paramFilter = Astro.url.searchParams.get('filter') ?? 'pending';
const currentFilter: Filter =
  paramFilter === 'found' || paramFilter === 'all' ? paramFilter : 'pending';

const rows = await listWishlist(env.AUTH_DB, sess.username);

const resolved = rows
  .map((row) => {
    const r = resolveWishlistRow(row);
    return r ? { row, resolved: r } : null;
  })
  .filter(
    (
      x
    ): x is {
      row: typeof rows[number];
      resolved: NonNullable<ReturnType<typeof resolveWishlistRow>>;
    } => x !== null
  );

const pendingCount = resolved.filter((r) => !r.resolved.found).length;
const foundCount = resolved.filter((r) => r.resolved.found).length;
const totalCount = resolved.length;

const visible =
  currentFilter === 'pending'
    ? resolved.filter((r) => !r.resolved.found)
    : currentFilter === 'found'
      ? resolved.filter((r) => r.resolved.found)
      : resolved;
---

<BaseLayout title="D2 Wishlist — AppHub">
  <div class="mb-6 flex items-baseline justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
        D2 Wishlist
      </h1>
      <p class="mt-1 text-sm text-zinc-500">
        Tus armas favoritas de Destiny 2 con las perks más usadas de la comunidad.
      </p>
    </div>
    <span class="text-xs uppercase tracking-wider text-zinc-500">
      {totalCount} {totalCount === 1 ? 'arma' : 'armas'}
    </span>
  </div>

  <div class="mb-6">
    <p
      class="rounded-2xl border border-zinc-200 bg-white p-4 text-sm text-zinc-500 dark:border-white/10 dark:bg-white/[0.025]"
      data-add-hint
    >
      Tocá <span class="font-medium text-zinc-900 dark:text-white">+ Agregar arma</span> abajo a la derecha para sumar un arma a tu wishlist.
    </p>
  </div>

  {
    totalCount > 0 && (
      <div
        class="mb-4 inline-flex rounded-lg border border-zinc-200 p-1 dark:border-white/10"
        data-filter-group
        role="tablist"
        aria-label="Filtrar wishlist"
      >
        {(['pending', 'found', 'all'] as const).map((f) => (
          <button
            type="button"
            role="tab"
            aria-selected={currentFilter === f}
            data-filter-tab={f}
            class:list={[
              'rounded-md px-3 py-1.5 text-xs font-medium uppercase tracking-wider transition',
              currentFilter === f
                ? 'bg-zinc-900 text-white dark:bg-white dark:text-zinc-900'
                : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white',
            ]}
          >
            {f === 'pending' && `Pendientes (${pendingCount})`}
            {f === 'found' && `Encontradas (${foundCount})`}
            {f === 'all' && `Todas (${totalCount})`}
          </button>
        ))}
      </div>
    )
  }

  {
    totalCount === 0 ? (
      <p
        class="rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500"
        data-empty-state
        data-scope="all"
      >
        Tu wishlist está vacía. Buscá un arma arriba y agregala con un click.
      </p>
    ) : (
      <>
        <div
          class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
          data-weapons-grid
          data-filter={currentFilter}
        >
          {visible.map(({ resolved }) => (
            <WeaponCard
              itemHash={resolved.itemHash}
              name={resolved.name}
              iconPath={resolved.iconPath}
              perk1={resolved.perk1 ?? { hash: '', name: '', icon: '' }}
              perk2={resolved.perk2 ?? { hash: '', name: '', icon: '' }}
              found={resolved.found}
              foundAt={resolved.foundAt}
            />
          ))}
        </div>

        <p
          class="mt-4 hidden rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500"
          data-empty-state
          data-scope="filter"
        >
          {currentFilter === 'pending' &&
            'No tenés armas pendientes — todas encontradas.'}
          {currentFilter === 'found' &&
            'Ninguna marcada como encontrada todavía.'}
          {currentFilter === 'all' && 'Tu wishlist está vacía.'}
        </p>
      </>
    )
  }

  <script is:inline define:vars={{ initialFilter: currentFilter }}>
    window.currentFilter = initialFilter;

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[c]);
    }

    function buildCard(w) {
      const el = document.createElement('article');
      el.dataset.weaponCard = '';
      el.dataset.found = w.found ? '1' : '0';
      el.dataset.itemHash = w.itemHash;
      el.className =
        'group relative flex flex-col gap-3 rounded-2xl border border-zinc-200 bg-white p-5 transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur';
      el.innerHTML = `
        <div class="flex items-center justify-center">
          <div class="flex h-28 w-28 items-center justify-center overflow-hidden rounded-lg bg-zinc-100 dark:bg-white/[0.04]">
            <img src="/destiny/api/icon?type=weapon&hash=${encodeURIComponent(w.itemHash)}" alt="${escapeHtml(w.name)}" loading="lazy" class="h-24 w-24 object-contain" style="image-rendering: -webkit-optimize-contrast;" />
          </div>
        </div>
        <h3 class="font-semibold text-zinc-900 dark:text-white">${escapeHtml(w.name)}</h3>
        <div class="flex items-center gap-2">
          <img src="/destiny/api/icon?type=perk&hash=${encodeURIComponent(w.perk1.hash)}" alt="${escapeHtml(w.perk1.name)}" title="${escapeHtml(w.perk1.name)}" loading="lazy" class="h-10 w-10 rounded ring-1 ring-zinc-200 dark:ring-white/10" />
          <img src="/destiny/api/icon?type=perk&hash=${encodeURIComponent(w.perk2.hash)}" alt="${escapeHtml(w.perk2.name)}" title="${escapeHtml(w.perk2.name)}" loading="lazy" class="h-10 w-10 rounded ring-1 ring-zinc-200 dark:ring-white/10" />
        </div>
        <div class="mt-auto flex items-center justify-between gap-2 pt-1">
          <button type="button" data-toggle-found data-item-hash="${escapeHtml(w.itemHash)}" data-found="false" class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white">Marcar encontrada</button>
          <button type="button" data-remove-weapon data-item-hash="${escapeHtml(w.itemHash)}" title="Quitar de la wishlist" aria-label="Quitar" class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-red-500 dark:text-zinc-500 dark:hover:text-red-400">×</button>
        </div>
      `;
      return el;
    }

    window.addEventListener('destiny:weapon-added', (e) => {
      const added = e && e.detail;
      const grid = document.querySelector('[data-weapons-grid]');
      const allEmpty = document.querySelector('[data-empty-state][data-scope="all"]');
      const hint = document.querySelector('[data-add-hint]');
      if (grid && added) {
        const node = buildCard(added);
        grid.prepend(node);
      }
      if (allEmpty) allEmpty.classList.add('hidden');
      if (hint) hint.classList.add('hidden');
      if (typeof window.updateFilterCounts === 'function') window.updateFilterCounts();
      if (typeof window.applyFilter === 'function') window.applyFilter(window.currentFilter || 'pending');
    });

    function setActiveTab(filter) {
      document.querySelectorAll('[data-filter-tab]').forEach((tab) => {
        const active = tab.dataset.filterTab === filter;
        tab.setAttribute('aria-selected', String(active));
        if (active) {
          tab.classList.add('bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900');
          tab.classList.remove('text-zinc-500', 'dark:text-zinc-500');
        } else {
          tab.classList.remove('bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900');
          tab.classList.add('text-zinc-500', 'dark:text-zinc-500');
        }
      });
    }

    window.applyFilter = function applyFilter(filter) {
      window.currentFilter = filter;
      const grid = document.querySelector('[data-weapons-grid]');
      if (grid) grid.dataset.filter = filter;
      let visible = 0;
      document.querySelectorAll('[data-weapon-card]').forEach((card) => {
        const isFound = card.dataset.found === '1';
        const show =
          filter === 'all' ||
          (filter === 'pending' && !isFound) ||
          (filter === 'found' && isFound);
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      const scopedEmpty = document.querySelector('[data-empty-state][data-scope]');
      if (scopedEmpty) {
        const scope = scopedEmpty.dataset.scope;
        const shouldShow = scope === filter && visible === 0;
        scopedEmpty.classList.toggle('hidden', !shouldShow);
      }
      setActiveTab(filter);
    };

    window.updateFilterCounts = function updateFilterCounts() {
      const cards = document.querySelectorAll('[data-weapon-card]');
      let pending = 0;
      let found = 0;
      cards.forEach((c) => {
        if (c.dataset.found === '1') found++;
        else pending++;
      });
      const total = pending + found;
      const setText = (key, txt) => {
        const tab = document.querySelector('[data-filter-tab="' + key + '"]');
        if (tab) tab.textContent = txt;
      };
      setText('pending', 'Pendientes (' + pending + ')');
      setText('found', 'Encontradas (' + found + ')');
      setText('all', 'Todas (' + total + ')');
    };

    document.querySelector('[data-filter-group]')?.addEventListener('click', (e) => {
      const tab = e.target.closest('[data-filter-tab]');
      if (!tab) return;
      const filter = tab.dataset.filterTab;
      const url = new URL(window.location.href);
      url.searchParams.set('filter', filter);
      history.replaceState(null, '', url.toString());
      window.applyFilter(filter);
    });

    document.querySelector('[data-weapons-grid]')?.addEventListener('click', async (e) => {
      const toggleBtn = e.target.closest('[data-toggle-found]');
      const removeBtn = e.target.closest('[data-remove-weapon]');
      if (toggleBtn) {
        e.preventDefault();
        const card = toggleBtn.closest('[data-weapon-card]');
        const wasFound = toggleBtn.dataset.found === 'true';
        const itemHash = toggleBtn.dataset.itemHash;
        const nowFound = !wasFound;
        toggleBtn.dataset.found = String(nowFound);
        toggleBtn.textContent = nowFound ? 'Marcar pendiente' : 'Marcar encontrada';
        if (card) {
          card.dataset.found = nowFound ? '1' : '0';
          const h3 = card.querySelector('h3');
          if (h3) h3.classList.toggle('line-through', nowFound);
          let badge = card.querySelector('[data-found-badge]');
          if (nowFound && !badge) {
            badge = document.createElement('span');
            badge.dataset.foundBadge = '1';
            badge.className =
              'absolute left-3 top-3 grid h-6 w-6 place-items-center rounded-full bg-emerald-500 text-xs font-semibold text-white';
            badge.setAttribute('aria-label', 'Encontrada');
            badge.title = 'Encontrada';
            badge.textContent = '✓';
            card.appendChild(badge);
          } else if (!nowFound && badge) {
            badge.remove();
          }
        }
        if (toggleBtn.dataset.found === 'true') {
          toggleBtn.classList.add('text-emerald-600', 'dark:text-emerald-400');
          toggleBtn.classList.remove('text-zinc-500', 'dark:text-zinc-500');
        } else {
          toggleBtn.classList.remove('text-emerald-600', 'dark:text-emerald-400');
          toggleBtn.classList.add('text-zinc-500', 'dark:text-zinc-500');
        }
        window.updateFilterCounts();
        window.applyFilter(window.currentFilter);
        try {
          const res = await fetch('/destiny/api/toggle-found', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemHash }),
          });
          if (!res.ok) throw new Error('toggle failed');
        } catch {
          // Rollback
          toggleBtn.dataset.found = String(wasFound);
          toggleBtn.textContent = wasFound ? 'Marcar pendiente' : 'Marcar encontrada';
          if (card) {
            card.dataset.found = wasFound ? '1' : '0';
            const h3 = card.querySelector('h3');
            if (h3) h3.classList.toggle('line-through', wasFound);
            let badge = card.querySelector('[data-found-badge]');
            if (wasFound && !badge) {
              badge = document.createElement('span');
              badge.dataset.foundBadge = '1';
              badge.className =
                'absolute left-3 top-3 grid h-6 w-6 place-items-center rounded-full bg-emerald-500 text-xs font-semibold text-white';
              badge.setAttribute('aria-label', 'Encontrada');
              badge.textContent = '✓';
              card.appendChild(badge);
            } else if (!wasFound && badge) {
              badge.remove();
            }
          }
          window.updateFilterCounts();
          window.applyFilter(window.currentFilter);
        }
        return;
      }
      if (removeBtn) {
        e.preventDefault();
        const card = removeBtn.closest('[data-weapon-card]');
        const itemHash = removeBtn.dataset.itemHash;
        if (!card || !itemHash) return;
        card.style.transition = 'opacity 0.2s';
        card.style.opacity = '0';
        try {
          const res = await fetch('/destiny/api/remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemHash }),
          });
          if (!res.ok && res.status !== 204) throw new Error('remove failed');
        } catch {
          card.style.opacity = '';
          return;
        }
        setTimeout(() => {
          card.remove();
          window.updateFilterCounts();
          window.applyFilter(window.currentFilter);
          const grid = document.querySelector('[data-weapons-grid]');
          const totalEmpty = document.querySelector('[data-empty-state][data-scope="all"]');
          if (grid && grid.children.length === 0 && totalEmpty) {
            grid.remove();
            totalEmpty.classList.remove('hidden');
          }
        }, 200);
      }
    });
  </script>

  <AddWeaponDialog />
</BaseLayout>
