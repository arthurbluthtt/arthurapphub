---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddGameDialog from '../../components/games/AddGameDialog.astro';
import { lookupSession, readCookie } from '../../lib/auth';
import { listGames, STATUSES, STATUS_LABELS } from '../../lib/games/store';

export const prerender = false;

const sessionId = readCookie(Astro.request);
const sess = sessionId ? await lookupSession(env.AUTH_DB, sessionId) : null;
if (!sess) {
  return Astro.redirect('/?next=' + encodeURIComponent('/games'));
}

const games = await listGames(env.AUTH_DB, sess.username);
const counts: Record<string, number> = {};
for (const s of STATUSES) counts[s] = games.filter((g) => g.status === s).length;
const totalCount = games.length;

const FILTER_TABS = ['all', ...STATUSES] as const;
---

<BaseLayout title="GameTracker — AppHub" contentMaxWidth="max-w-[1760px] 2xl:max-w-[2240px]">
  <div class="mb-6 flex items-baseline justify-between gap-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl xl:text-5xl dark:text-white">
        GameTracker
      </h1>
      <p class="mt-2 text-sm text-zinc-500 xl:text-base">
        Mis juegos con estado: portada de Steam, año de salida y progreso.
      </p>
    </div>
    <span class="text-xs uppercase tracking-wider text-zinc-500 xl:text-sm">
      {totalCount} {totalCount === 1 ? 'juego' : 'juegos'}
    </span>
  </div>

  {
    totalCount > 0 && (
      <div
        class="mb-4 flex flex-wrap gap-2"
        data-filter-group
        role="tablist"
        aria-label="Filtrar por estado"
      >
        {FILTER_TABS.map((f) => (
          <button
            type="button"
            role="tab"
            aria-selected={f === 'all'}
            data-filter-tab={f}
            class:list={[
              'rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-wider transition',
              f === 'all'
                ? 'border-zinc-900 bg-zinc-900 text-white dark:border-white dark:bg-white dark:text-zinc-900'
                : 'border-zinc-200 text-zinc-500 hover:border-zinc-400 hover:text-zinc-900 dark:border-white/10 dark:text-zinc-500 dark:hover:border-white/30 dark:hover:text-white',
            ]}
          >
            {f === 'all' ? `Todas (${totalCount})` : `${STATUS_LABELS[f]} (${counts[f]})`}
          </button>
        ))}
      </div>
    )
  }

  {
    totalCount === 0 ? (
      <p
        class="rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500"
        data-empty-state
      >
        Tu lista está vacía. Buscá un juego en Steam y agregalo con un click.
      </p>
    ) : (
      <div
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
        data-games-grid
      >
        {games.map((g) => (
          <article
            data-game-card
            data-game-id={g.id}
            data-status={g.status}
            class="overflow-hidden rounded-2xl border border-zinc-200 bg-white transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur"
          >
            <div class="relative aspect-[460/215] overflow-hidden bg-zinc-100 dark:bg-white/[0.04]">
              {g.coverUrl ? (
                <img
                  src={g.coverUrl}
                  alt={g.name}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div
                  class="grid h-full w-full place-items-center bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-white/[0.04] dark:to-white/[0.06]"
                  aria-hidden="true"
                >
                  <span class="text-3xl font-bold tracking-wide text-zinc-300 dark:text-zinc-600">
                    {g.name.split(/\s+/).slice(0, 2).map((w) => w[0] ?? '').join('').toUpperCase()}
                  </span>
                </div>
              )}
              {g.year && (
                <span class="absolute left-2 top-2 rounded-full bg-zinc-950/70 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-white backdrop-blur">
                  {g.year}
                </span>
              )}
            </div>
            <div class="flex items-start gap-3 p-4">
              <div class="min-w-0 flex-1">
                <h3 class="truncate font-semibold text-zinc-900 dark:text-white">{g.name}</h3>
                <button
                  type="button"
                  data-status-button
                  data-game-id={g.id}
                  data-status={g.status}
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  class="mt-2 flex w-full items-center justify-between gap-2 rounded-lg border border-zinc-300 bg-white px-2.5 py-2 text-xs font-medium text-zinc-700 outline-none transition hover:border-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-200 dark:hover:border-white/30 dark:focus:border-white/30"
                >
                  <span data-status-label class="truncate">{STATUS_LABELS[g.status]}</span>
                  <span aria-hidden="true" class="shrink-0 text-[10px] text-zinc-400 dark:text-zinc-500">
                    ▾
                  </span>
                </button>
              </div>
              <button
                type="button"
                data-remove-game
                data-game-id={g.id}
                title="Eliminar juego"
                aria-label="Eliminar"
                class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-red-500/10 dark:hover:text-red-400"
              >
                ×
              </button>
            </div>
          </article>
        ))}
      </div>
    )
  }

  <p
    class="hidden rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500"
    data-filtered-empty
  >
    No tenés juegos con ese estado.
  </p>

  <script
    is:inline
    define:vars={{
      gamesInitial: games,
      statusKeys: STATUSES,
      statusLabels: STATUS_LABELS,
    }}
  >
    const emptyDataUrl =
      "data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect width=\"64\" height=\"64\" fill=\"%23e4e4e7\"/><text x=\"50%\" y=\"58%\" font-size=\"28\" text-anchor=\"middle\" fill=\"%2371717a\" font-family=\"sans-serif\">?</text></svg>";

    const grid = document.querySelector("[data-games-grid]");
    const emptyState = document.querySelector("[data-empty-state]");
    const filteredEmpty = document.querySelector("[data-filtered-empty]");
    const filterGroup = document.querySelector("[data-filter-group]");

    const FILTER_ACTIVE = [
      "border-zinc-900",
      "bg-zinc-900",
      "text-white",
      "dark:border-white",
      "dark:bg-white",
      "dark:text-zinc-900",
    ];
    const FILTER_INACTIVE = [
      "border-zinc-200",
      "text-zinc-500",
      "hover:border-zinc-400",
      "hover:text-zinc-900",
      "dark:border-white/10",
      "dark:text-zinc-500",
      "dark:hover:border-white/30",
      "dark:hover:text-white",
    ];

    let games = gamesInitial.map((g) => ({ ...g }));
    let currentFilter = "all";

    function findCard(id) {
      return document.querySelector('[data-game-card][data-game-id="' + id + '"]');
    }

    function buildGameCard(game) {
      const article = document.createElement("article");
      article.dataset.gameCard = "";
      article.dataset.gameId = game.id;
      article.dataset.status = game.status;
      article.className =
        "overflow-hidden rounded-2xl border border-zinc-200 bg-white transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur";

      const coverWrap = document.createElement("div");
      coverWrap.className =
        "relative aspect-[460/215] overflow-hidden bg-zinc-100 dark:bg-white/[0.04]";
      if (game.coverUrl) {
        const img = document.createElement("img");
        img.src = game.coverUrl;
        img.alt = game.name || "";
        img.loading = "lazy";
        img.className = "h-full w-full object-cover";
        img.onerror = () => {
          img.onerror = null;
          img.src = emptyDataUrl;
        };
        coverWrap.appendChild(img);
      } else {
        const ph = document.createElement("div");
        ph.setAttribute("aria-hidden", "true");
        ph.className =
          "grid h-full w-full place-items-center bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-white/[0.04] dark:to-white/[0.06]";
        const initials = document.createElement("span");
        initials.className = "text-3xl font-bold tracking-wide text-zinc-300 dark:text-zinc-600";
        initials.textContent = String(game.name || "")
          .split(/\s+/)
          .slice(0, 2)
          .map((w) => w[0] || "")
          .join("")
          .toUpperCase();
        ph.appendChild(initials);
        coverWrap.appendChild(ph);
      }
      if (game.year) {
        const badge = document.createElement("span");
        badge.className =
          "absolute left-2 top-2 rounded-full bg-zinc-950/70 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-white backdrop-blur";
        badge.textContent = String(game.year);
        coverWrap.appendChild(badge);
      }
      article.appendChild(coverWrap);

      const body = document.createElement("div");
      body.className = "flex items-start gap-3 p-4";
      const info = document.createElement("div");
      info.className = "min-w-0 flex-1";
      const nameEl = document.createElement("h3");
      nameEl.className = "truncate font-semibold text-zinc-900 dark:text-white";
      nameEl.textContent = game.name || "";
      info.appendChild(nameEl);

      const statusBtn = document.createElement("button");
      statusBtn.type = "button";
      statusBtn.dataset.statusButton = "";
      statusBtn.dataset.gameId = game.id;
      statusBtn.dataset.status = game.status;
      statusBtn.setAttribute("aria-haspopup", "listbox");
      statusBtn.setAttribute("aria-expanded", "false");
      statusBtn.className =
        "mt-2 flex w-full items-center justify-between gap-2 rounded-lg border border-zinc-300 bg-white px-2.5 py-2 text-xs font-medium text-zinc-700 outline-none transition hover:border-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-200 dark:hover:border-white/30 dark:focus:border-white/30";

      const labelEl = document.createElement("span");
      labelEl.dataset.statusLabel = "";
      labelEl.className = "truncate";
      labelEl.textContent = statusLabels[game.status] || game.status;
      statusBtn.appendChild(labelEl);

      const caret = document.createElement("span");
      caret.setAttribute("aria-hidden", "true");
      caret.className = "shrink-0 text-[10px] text-zinc-400 dark:text-zinc-500";
      caret.textContent = "▾";
      statusBtn.appendChild(caret);

      info.appendChild(statusBtn);
      body.appendChild(info);

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.dataset.removeGame = "";
      removeBtn.dataset.gameId = game.id;
      removeBtn.title = "Eliminar juego";
      removeBtn.ariaLabel = "Eliminar";
      removeBtn.className =
        "grid h-7 w-7 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-red-500/10 dark:hover:text-red-400";
      removeBtn.textContent = "×";
      body.appendChild(removeBtn);

      article.appendChild(body);
      return article;
    }

    function renderCounts() {
      if (!filterGroup) return;
      filterGroup.querySelectorAll("[data-filter-tab]").forEach((tab) => {
        const key = tab.dataset.filterTab;
        const count =
          key === "all"
            ? games.length
            : games.filter((g) => g.status === key).length;
        const label = key === "all" ? "Todas" : statusLabels[key] || key;
        tab.textContent = label + " (" + count + ")";
      });
    }

    function applyFilter() {
      const cards = grid ? Array.from(grid.querySelectorAll("[data-game-card]")) : [];
      let visible = 0;
      for (const card of cards) {
        const show = currentFilter === "all" || card.dataset.status === currentFilter;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      }
      if (filteredEmpty) {
        filteredEmpty.classList.toggle(
          "hidden",
          !(currentFilter !== "all" && games.length > 0 && visible === 0)
        );
      }
    }

    function syncVisibility() {
      const noGames = games.length === 0;
      if (grid) grid.classList.toggle("hidden", noGames);
      if (emptyState) emptyState.classList.toggle("hidden", !noGames);
    }

    function setActiveTab() {
      if (!filterGroup) return;
      filterGroup.querySelectorAll("[data-filter-tab]").forEach((t) => {
        const active = t.dataset.filterTab === currentFilter;
        t.setAttribute("aria-selected", active ? "true" : "false");
        for (const c of FILTER_ACTIVE) t.classList.toggle(c, active);
        for (const c of FILTER_INACTIVE) t.classList.toggle(c, !active);
      });
    }

    filterGroup?.addEventListener("click", (e) => {
      const tab = e.target.closest("[data-filter-tab]");
      if (!tab) return;
      currentFilter = tab.dataset.filterTab;
      setActiveTab();
      applyFilter();
    });

    // --- Status dropdown custom (patrón del perk dropdown de D2) ---
    // El <select> nativo abría el popup con estilos del OS (texto gris sobre
    // blanco en dark mode, y desalineado). Este dropdown es un singleton en
    // <body> con position:fixed y atomic reveal: las coordenadas se aplican
    // ANTES de quitar 'hidden' para que el navegador nunca lo vea con
    // position:static.

    let statusMenu = null;
    let statusMenuBtn = null;

    function ensureStatusMenu() {
      if (statusMenu) return statusMenu;
      statusMenu = document.createElement("div");
      statusMenu.dataset.statusMenu = "";
      statusMenu.className =
        "fixed z-[9999] hidden overflow-hidden rounded-lg border border-zinc-300 bg-white p-1 text-zinc-900 shadow-2xl ring-1 ring-black/5 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100";
      statusMenu.setAttribute("role", "listbox");
      document.body.appendChild(statusMenu);
      statusMenu.addEventListener("click", async (e) => {
        const opt = e.target.closest("[data-status-option]");
        if (!opt || opt.disabled) return;
        const id = opt.dataset.gameId;
        const status = opt.dataset.statusOption;
        opt.disabled = true;
        try {
          const res = await fetch("/games/api/set-status", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, status }),
          });
          if (!res.ok) throw new Error("set-status");
          const data = await res.json();
          const game = games.find((g) => g.id === id);
          if (game) game.status = data.game.status;
          const card = findCard(id);
          if (card) {
            card.dataset.status = data.game.status;
            const btn = card.querySelector("[data-status-button]");
            if (btn) {
              btn.dataset.status = data.game.status;
              const labelEl = btn.querySelector("[data-status-label]");
              if (labelEl) labelEl.textContent = statusLabels[data.game.status] || data.game.status;
            }
          }
          renderCounts();
          applyFilter();
          closeStatusMenu();
        } catch {
          closeStatusMenu();
        }
      });
      return statusMenu;
    }

    function closeStatusMenu() {
      if (!statusMenu) return;
      statusMenu.classList.add("hidden");
      statusMenu.replaceChildren();
      if (statusMenuBtn) {
        statusMenuBtn.setAttribute("aria-expanded", "false");
        statusMenuBtn = null;
      }
    }

    function openStatusMenu(btn) {
      const menu = ensureStatusMenu();
      closeStatusMenu();
      statusMenuBtn = btn;
      btn.setAttribute("aria-expanded", "true");

      for (const key of statusKeys) {
        const opt = document.createElement("button");
        opt.type = "button";
        opt.dataset.statusOption = key;
        opt.dataset.gameId = btn.dataset.gameId;
        opt.setAttribute("role", "option");
        opt.setAttribute("aria-selected", key === btn.dataset.status ? "true" : "false");
        opt.className =
          "flex w-full cursor-pointer items-center justify-between gap-2 rounded-md px-2.5 py-1.5 text-left text-xs font-medium text-zinc-900 hover:bg-zinc-100 dark:text-zinc-100 dark:hover:bg-white/10";
        const label = document.createElement("span");
        label.textContent = statusLabels[key] || key;
        opt.appendChild(label);
        if (key === btn.dataset.status) {
          const check = document.createElement("span");
          check.className = "shrink-0 text-zinc-400 dark:text-zinc-500";
          check.textContent = "✓";
          opt.appendChild(check);
        }
        menu.appendChild(opt);
      }

      // Atomic reveal: posicionar antes de revelar.
      const rect = btn.getBoundingClientRect();
      const gap = 4;
      const menuH = statusKeys.length * 30 + 8;
      const spaceBelow = window.innerHeight - rect.bottom - gap - 8;
      const useAbove = spaceBelow < menuH && rect.top > spaceBelow;
      const width = Math.max(120, Math.min(rect.width, window.innerWidth - 16));
      const left = Math.max(8, Math.min(window.innerWidth - width - 8, rect.left));
      menu.style.width = width + "px";
      menu.style.left = left + "px";
      menu.style.top = useAbove ? Math.max(8, rect.top - gap - menuH) + "px" : rect.bottom + gap + "px";
      menu.classList.remove("hidden");
    }

    document.addEventListener("click", (e) => {
      if (!statusMenu || statusMenu.classList.contains("hidden")) return;
      if (statusMenu.contains(e.target)) return;
      if (e.target.closest("[data-status-button]")) return;
      closeStatusMenu();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeStatusMenu();
    });
    window.addEventListener("scroll", closeStatusMenu, true);
    window.addEventListener("resize", closeStatusMenu);

    grid?.addEventListener("click", async (e) => {
      const statusBtn = e.target.closest("[data-status-button]");
      if (statusBtn) {
        e.preventDefault();
        if (
          statusMenuBtn === statusBtn &&
          statusMenu &&
          !statusMenu.classList.contains("hidden")
        ) {
          closeStatusMenu();
        } else {
          openStatusMenu(statusBtn);
        }
        return;
      }
      const removeBtn = e.target.closest("[data-remove-game]");
      if (!removeBtn) return;
      e.preventDefault();
      const id = removeBtn.dataset.gameId;
      const card = findCard(id);
      if (!card) return;
      card.style.transition = "opacity 0.2s";
      card.style.opacity = "0";
      try {
        const res = await fetch("/games/api/remove", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });
        if (!res.ok && res.status !== 204) throw new Error("remove");
      } catch {
        card.style.opacity = "";
        return;
      }
      setTimeout(() => {
        games = games.filter((g) => g.id !== id);
        card.remove();
        renderCounts();
        syncVisibility();
        applyFilter();
      }, 200);
    });

    window.addEventListener("games:game-added", (e) => {
      const detail = e && e.detail;
      if (!detail || !detail.game) return;
      games.unshift(detail.game);
      const card = buildGameCard(detail.game);
      if (grid) {
        grid.prepend(card);
        grid.classList.remove("hidden");
      }
      if (emptyState) emptyState.classList.add("hidden");
      renderCounts();
      applyFilter();
    });
  </script>

  <AddGameDialog />
</BaseLayout>
