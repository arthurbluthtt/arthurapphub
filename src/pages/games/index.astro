---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddGameDialog from '../../components/games/AddGameDialog.astro';
import EditGameDialog from '../../components/games/EditGameDialog.astro';
import RandomPickDialog from '../../components/games/RandomPickDialog.astro';
import SearchBar from '../../components/SearchBar.astro';
import { lookupSession, readCookie } from '../../lib/auth';
import { listGames, STATUSES, STATUS_LABELS } from '../../lib/games/store';

export const prerender = false;

const sessionId = readCookie(Astro.request);
const sess = sessionId ? await lookupSession(env.AUTH_DB, sessionId) : null;
if (!sess) {
  return Astro.redirect('/?next=' + encodeURIComponent('/games'));
}

const games = await listGames(env.AUTH_DB, sess.username);
const counts: Record<string, number> = { backlog: 0, playing: 0, finished: 0 };
for (const g of games) counts[g.status]++;
const totalCount = games.length;

// Sagas únicas en la lista del usuario (para el dropdown de filtro).
// Orden: las que más juegos tienen primero, luego alfabético.
const sagaCounts = new Map<string, number>();
for (const g of games) {
  if (g.saga) sagaCounts.set(g.saga, (sagaCounts.get(g.saga) ?? 0) + 1);
}
const userSagas = [...sagaCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([s]) => s);

const FILTER_TABS = ['all', ...STATUSES] as const;
---

<BaseLayout title="GameTracker — AppHub" contentMaxWidth="max-w-[1760px] 2xl:max-w-[2240px]">
  <div class="mb-6 flex items-baseline justify-between gap-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl xl:text-5xl dark:text-white">
        GameTracker
      </h1>
      <p class="mt-2 text-sm text-zinc-500 xl:text-base">
        Mis juegos con estado: portada de Steam, año de salida y progreso.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <button
        type="button"
        data-random-pick
        aria-label="Elegir un juego por jugar al azar"
        disabled={counts.backlog === 0}
        class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-700 transition hover:border-zinc-400 hover:bg-zinc-100 hover:text-zinc-900 focus:outline-none focus:ring-2 focus:ring-zinc-400 disabled:cursor-not-allowed disabled:opacity-50 dark:border-white/10 dark:text-zinc-200 dark:hover:border-white/30 dark:hover:bg-white/10 dark:hover:text-white"
      >
        <span aria-hidden="true">🎲</span>
        <span>Random pick</span>
      </button>
      <span class="text-xs uppercase tracking-wider text-zinc-500 xl:text-sm" data-games-count>
        {totalCount} {totalCount === 1 ? 'juego' : 'juegos'}
      </span>
    </div>
  </div>

  {userSagas.length > 0 && (
    <div
      class:list={[
        'mb-4 flex items-center justify-end gap-2',
        totalCount === 0 && 'hidden',
      ]}
      data-saga-filter-group
    >
      <label
        for="saga-filter-select"
        class="text-xs font-medium uppercase tracking-wider text-zinc-500"
      >
        Saga:
      </label>
      <select
        id="saga-filter-select"
        data-saga-filter
        class="rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-700 outline-none transition hover:border-zinc-400 focus:border-zinc-500 [&>option]:bg-white [&>option]:text-zinc-900 dark:border-white/10 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:border-white/30 dark:focus:border-white/30 dark:[&>option]:bg-zinc-800 dark:[&>option]:text-zinc-100"
      >
        <option value="__all__">Todas ({totalCount})</option>
        {userSagas.map((s) => {
          const n = sagaCounts.get(s) ?? 0;
          return <option value={s}>{s} ({n})</option>;
        })}
      </select>
    </div>
  )}

  <SearchBar placeholder="Buscar..." />

  <div
    class:list={[
      'mb-4 flex flex-wrap gap-2',
      totalCount === 0 && 'hidden',
    ]}
    data-filter-group
    role="tablist"
    aria-label="Filtrar por estado"
  >
    {FILTER_TABS.map((f) => (
      <button
        type="button"
        role="tab"
        aria-selected={f === 'all'}
        data-filter-tab={f}
        class:list={[
          'rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-wider transition',
          f === 'all'
            ? 'border-zinc-900 bg-zinc-900 text-white dark:border-white dark:bg-white dark:text-zinc-900'
            : 'border-zinc-200 text-zinc-500 hover:border-zinc-400 hover:text-zinc-900 dark:border-white/10 dark:text-zinc-500 dark:hover:border-white/30 dark:hover:text-white',
        ]}
      >
        {f === 'all' ? `Todas (${totalCount})` : `${STATUS_LABELS[f]} (${counts[f]})`}
      </button>
    ))}
  </div>

  <p
    class:list={[
      'rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500',
      totalCount > 0 && 'hidden',
    ]}
    data-empty-state
  >
    Tu lista está vacía. Buscá un juego en Steam y agregalo con un click.
  </p>

  <div
    class:list={[
      'grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7',
      totalCount === 0 && 'hidden',
    ]}
    data-games-grid
  >
  {
    games.map((g) => (
      <article
        data-game-card
        data-game-id={g.id}
        data-status={g.status}
        data-saga={g.saga ?? ''}
        data-search={(g.name + ' ' + (g.saga ?? '')).toLowerCase()}
        class="overflow-hidden rounded-2xl border border-zinc-200 bg-white transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur"
      >
          <div class="relative aspect-[460/215] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
            {g.coverUrl ? (
              <img
                src={g.coverUrl}
                alt={g.name}
                loading="lazy"
                decoding="async"
                data-game-cover-image
                class="h-full w-full object-cover"
              />
            ) : (
              <div
                class="grid h-full w-full place-items-center bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-white/[0.04] dark:to-white/[0.06]"
                aria-hidden="true"
              >
                <span class="text-3xl font-bold tracking-wide text-zinc-300 dark:text-zinc-600">
                  {g.name.split(/\s+/).slice(0, 2).map((w) => w[0] ?? '').join('').toUpperCase()}
                </span>
              </div>
            )}
            {g.year && (
              <span class="absolute left-2 top-2 rounded-full bg-zinc-950/70 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-white backdrop-blur">
                {g.year}
              </span>
            )}
          </div>
          <div class="flex flex-col gap-1.5 p-2.5">
            <h3 class="truncate font-semibold text-zinc-900 dark:text-white">{g.name}</h3>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                data-status-button
                data-game-id={g.id}
                data-status={g.status}
                aria-haspopup="listbox"
                aria-expanded="false"
                class="flex flex-1 items-center justify-between gap-2 rounded-lg border border-zinc-300 bg-white px-2.5 py-1 text-xs font-medium text-zinc-700 outline-none transition hover:border-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-200 dark:hover:border-white/30 dark:focus:border-white/30"
              >
                <span data-status-label class="truncate">{STATUS_LABELS[g.status]}</span>
                <span aria-hidden="true" class="shrink-0 text-[10px] text-zinc-400 dark:text-zinc-500">
                  ▾
                </span>
              </button>
              <button
                type="button"
                data-remove-game
                data-game-id={g.id}
                title="Eliminar juego"
                aria-label="Eliminar"
                class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-red-500/10 dark:hover:text-red-400"
              >
                ×
              </button>
              <button
                type="button"
                data-edit-game
                data-game-id={g.id}
                data-game-name={g.name}
                data-game-year={g.year == null ? '' : String(g.year)}
                data-game-cover={g.coverUrl ?? ''}
                data-game-saga={g.saga ?? ''}
                title="Editar juego"
                aria-label="Editar"
                class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-zinc-200 hover:text-zinc-900 dark:text-zinc-500 dark:hover:bg-white/10 dark:hover:text-white"
              >
                <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M11.5 1.5l3 3-9 9H2.5v-3l9-9z" />
                </svg>
              </button>
            </div>
          </div>
        </article>
      ))}
      </div>

  <p
    class="hidden rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500"
    data-filtered-empty
  >
    No tenés juegos con ese estado.
  </p>

  <RandomPickDialog />

  <script
    is:inline
    define:vars={{
      gamesInitial: games,
      statusKeys: STATUSES,
      statusLabels: STATUS_LABELS,
      userSagasInitial: userSagas,
      sagaCountsInitial: Object.fromEntries(sagaCounts),
    }}
  >
    const emptyDataUrl =
      "data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect width=\"64\" height=\"64\" fill=\"%23e4e4e7\"/><text x=\"50%\" y=\"58%\" font-size=\"28\" text-anchor=\"middle\" fill=\"%2371717a\" font-family=\"sans-serif\">?</text></svg>";

    const grid = document.querySelector("[data-games-grid]");
    const emptyState = document.querySelector("[data-empty-state]");
    const filteredEmpty = document.querySelector("[data-filtered-empty]");
    const filterGroup = document.querySelector("[data-filter-group]");
    const sagaFilterGroup = document.querySelector("[data-saga-filter-group]");
    const sagaFilterSelect = document.querySelector("[data-saga-filter]");
    const randomPickButton = document.querySelector("[data-random-pick]");
    const randomDialog = document.querySelector("[data-random-dialog]");
    const randomCover = randomDialog?.querySelector("[data-random-cover]");
    const randomFallback = randomDialog?.querySelector("[data-random-fallback]");
    const randomInitials = randomDialog?.querySelector("[data-random-initials]");
    const randomTitle = randomDialog?.querySelector("[data-random-title]");
    const randomMeta = randomDialog?.querySelector("[data-random-meta]");
    const randomSaga = randomDialog?.querySelector("[data-random-saga]");
    const randomError = randomDialog?.querySelector("[data-random-error]");
    const randomStart = randomDialog?.querySelector("[data-random-start]");

    const FILTER_ACTIVE = [
      "border-zinc-900",
      "bg-zinc-900",
      "text-white",
      "dark:border-white",
      "dark:bg-white",
      "dark:text-zinc-900",
    ];
    const FILTER_INACTIVE = [
      "border-zinc-200",
      "text-zinc-500",
      "hover:border-zinc-400",
      "hover:text-zinc-900",
      "dark:border-white/10",
      "dark:text-zinc-500",
      "dark:hover:border-white/30",
      "dark:hover:text-white",
    ];

    let games = gamesInitial.map((g) => ({ ...g }));
    let currentFilter = "all";
    let currentSaga = "__all__";
    let currentSearch = "";
    let selectedRandomGame = null;
    let lastRandomGameId = null;
    let bodyLocked = false;
    // Map saga → count (lo mantenemos sincronizado con `games`).
    const sagaCounts = new Map(Object.entries(sagaCountsInitial));

    function lockBodyScroll() {
      if (bodyLocked) return;
      bodyLocked = true;
      const sbw = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = "hidden";
      if (sbw > 0) document.body.style.paddingRight = sbw + "px";
    }

    function unlockBodyScroll() {
      if (!bodyLocked) return;
      bodyLocked = false;
      document.body.style.overflow = "";
      document.body.style.paddingRight = "";
    }

    function closeRandomDialog() {
      if (randomDialog instanceof HTMLDialogElement && randomDialog.open) {
        randomDialog.close();
      }
      selectedRandomGame = null;
      unlockBodyScroll();
    }

    function updateRandomPickState() {
      const hasBacklog = games.some((game) => game.status === "backlog");
      if (randomPickButton instanceof HTMLButtonElement) {
        randomPickButton.disabled = !hasBacklog;
      }
      if (!hasBacklog && randomDialog instanceof HTMLDialogElement && randomDialog.open) {
        closeRandomDialog();
      }
    }

    function renderRandomGame(game) {
      if (!game) return;
      const title = game.name || "Juego sin título";
      const initials = title
        .split(/\s+/)
        .slice(0, 2)
        .map((word) => word[0] || "")
        .join("")
        .toUpperCase();

      if (randomTitle) randomTitle.textContent = title;
      if (randomMeta) randomMeta.textContent = game.year ? String(game.year) : "Por jugar";
      if (randomSaga) {
        randomSaga.textContent = game.saga ? `Saga: ${game.saga}` : "";
        randomSaga.classList.toggle("hidden", !game.saga);
      }
      if (randomInitials) randomInitials.textContent = initials || "?";
      if (randomError) {
        randomError.textContent = "";
        randomError.classList.add("hidden");
      }

      if (randomCover instanceof HTMLImageElement && randomFallback) {
        randomCover.alt = title;
        if (game.coverUrl) {
          randomCover.src = game.coverUrl;
          randomCover.classList.remove("hidden");
          randomFallback.classList.add("hidden");
        } else {
          randomCover.removeAttribute("src");
          randomCover.classList.add("hidden");
          randomFallback.classList.remove("hidden");
        }
      }
      if (randomStart instanceof HTMLButtonElement) randomStart.disabled = false;
    }

    function openRandomDialog(game) {
      if (!(randomDialog instanceof HTMLDialogElement)) return;
      selectedRandomGame = game;
      renderRandomGame(game);
      if (!randomDialog.open) {
        lockBodyScroll();
        randomDialog.showModal();
      }
    }

    randomCover?.addEventListener("error", () => {
      randomCover.classList.add("hidden");
      randomFallback?.classList.remove("hidden");
    });

    randomDialog?.querySelectorAll("[data-random-close]").forEach((button) => {
      button.addEventListener("click", closeRandomDialog);
    });
    randomDialog?.addEventListener("click", (event) => {
      if (event.target === randomDialog) closeRandomDialog();
    });
    randomDialog?.addEventListener("close", () => {
      selectedRandomGame = null;
      unlockBodyScroll();
    });

    randomPickButton?.addEventListener("click", () => {
      const candidates = games.filter((game) => game.status === "backlog");
      if (candidates.length === 0) {
        updateRandomPickState();
        return;
      }
      const available = candidates.filter((game) => game.id !== lastRandomGameId);
      const pool = available.length > 0 ? available : candidates;
      const game = pool[Math.floor(Math.random() * pool.length)];
      lastRandomGameId = game.id;
      openRandomDialog(game);
    });

    randomStart?.addEventListener("click", async () => {
      if (!(randomStart instanceof HTMLButtonElement) || !selectedRandomGame) return;
      const id = selectedRandomGame.id;
      randomStart.disabled = true;
      if (randomError) {
        randomError.textContent = "";
        randomError.classList.add("hidden");
      }
      try {
        const response = await fetch("/games/api/set-status", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, status: "playing" }),
        });
        const data = await response.json().catch(() => null);
        if (!response.ok || !data?.game) throw new Error("No se pudo actualizar el estado.");

        const game = games.find((item) => item.id === id);
        if (game) game.status = data.game.status;
        const card = findCard(id);
        if (card) {
          card.dataset.status = data.game.status;
          const button = card.querySelector("[data-status-button]");
          if (button) {
            button.dataset.status = data.game.status;
            const label = button.querySelector("[data-status-label]");
            if (label) label.textContent = statusLabels[data.game.status] || data.game.status;
          }
        }
        renderCounts();
        applyFilter();
        updateRandomPickState();
        closeRandomDialog();
      } catch (error) {
        if (randomError) {
          randomError.textContent = error instanceof Error ? error.message : "No se pudo actualizar el estado.";
          randomError.classList.remove("hidden");
        }
        randomStart.disabled = false;
      }
    });

    // Fallback único para covers SSR y cards creadas en runtime.
    document.addEventListener("error", (e) => {
      const image = e.target;
      if (
        !(image instanceof HTMLImageElement) ||
        !image.matches("[data-game-cover-image]") ||
        image.dataset.fallbackApplied === "true"
      ) {
        return;
      }
      image.dataset.fallbackApplied = "true";
      image.src = emptyDataUrl;
    }, true);

    function findCard(id) {
      return Array.from(document.querySelectorAll("[data-game-card]")).find(
        (card) => card.dataset.gameId === id
      ) || null;
    }

    function buildGameCard(game) {
      const article = document.createElement("article");
      article.dataset.gameCard = "";
      article.dataset.gameId = game.id;
      article.dataset.status = game.status;
      article.dataset.saga = game.saga || "";
      article.dataset.search = ((game.name || "") + " " + (game.saga || "")).toLowerCase();
      article.className =
        "overflow-hidden rounded-2xl border border-zinc-200 bg-white transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur";

      const coverWrap = document.createElement("div");
      coverWrap.className =
        "relative aspect-[460/215] overflow-hidden bg-zinc-100 dark:bg-zinc-800";
      if (game.coverUrl) {
        const img = document.createElement("img");
        img.src = game.coverUrl;
        img.alt = game.name || "";
        img.loading = "lazy";
        img.decoding = "async";
        img.dataset.gameCoverImage = "";
        img.className = "h-full w-full object-cover";
        coverWrap.appendChild(img);
      } else {
        const ph = document.createElement("div");
        ph.setAttribute("aria-hidden", "true");
        ph.className =
          "grid h-full w-full place-items-center bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-white/[0.04] dark:to-white/[0.06]";
        const initials = document.createElement("span");
        initials.className = "text-3xl font-bold tracking-wide text-zinc-300 dark:text-zinc-600";
        initials.textContent = String(game.name || "")
          .split(/\s+/)
          .slice(0, 2)
          .map((w) => w[0] || "")
          .join("")
          .toUpperCase();
        ph.appendChild(initials);
        coverWrap.appendChild(ph);
      }
      if (game.year) {
        const badge = document.createElement("span");
        badge.className =
          "absolute left-2 top-2 rounded-full bg-zinc-950/70 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-white backdrop-blur";
        badge.textContent = String(game.year);
        coverWrap.appendChild(badge);
      }
      article.appendChild(coverWrap);

      const body = document.createElement("div");
      body.className = "flex flex-col gap-1.5 p-2.5";

      const nameEl = document.createElement("h3");
      nameEl.className = "truncate font-semibold text-zinc-900 dark:text-white";
      nameEl.textContent = game.name || "";
      body.appendChild(nameEl);

      const actionsRow = document.createElement("div");
      actionsRow.className = "flex items-center gap-1.5";

      const statusBtn = document.createElement("button");
      statusBtn.type = "button";
      statusBtn.dataset.statusButton = "";
      statusBtn.dataset.gameId = game.id;
      statusBtn.dataset.status = game.status;
      statusBtn.setAttribute("aria-haspopup", "listbox");
      statusBtn.setAttribute("aria-expanded", "false");
      statusBtn.className =
        "flex flex-1 items-center justify-between gap-2 rounded-lg border border-zinc-300 bg-white px-2.5 py-1 text-xs font-medium text-zinc-700 outline-none transition hover:border-zinc-400 focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-zinc-200 dark:hover:border-white/30 dark:focus:border-white/30";

      const labelEl = document.createElement("span");
      labelEl.dataset.statusLabel = "";
      labelEl.className = "truncate";
      labelEl.textContent = statusLabels[game.status] || game.status;
      statusBtn.appendChild(labelEl);

      const caret = document.createElement("span");
      caret.setAttribute("aria-hidden", "true");
      caret.className = "shrink-0 text-[10px] text-zinc-400 dark:text-zinc-500";
      caret.textContent = "▾";
      statusBtn.appendChild(caret);

      actionsRow.appendChild(statusBtn);

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.dataset.removeGame = "";
      removeBtn.dataset.gameId = game.id;
      removeBtn.title = "Eliminar juego";
      removeBtn.ariaLabel = "Eliminar";
      removeBtn.className =
        "grid h-6 w-6 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-red-500/10 dark:hover:text-red-400";
      removeBtn.textContent = "×";
      actionsRow.appendChild(removeBtn);

      const editBtn = document.createElement("button");
      editBtn.type = "button";
      editBtn.dataset.editGame = "";
      editBtn.dataset.gameId = game.id;
      editBtn.dataset.gameName = game.name || "";
      editBtn.dataset.gameYear = game.year == null ? "" : String(game.year);
      editBtn.dataset.gameCover = game.coverUrl || "";
      editBtn.dataset.gameSaga = game.saga || "";
      editBtn.title = "Editar juego";
      editBtn.ariaLabel = "Editar";
      editBtn.className =
        "grid h-6 w-6 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-zinc-200 hover:text-zinc-900 dark:text-zinc-500 dark:hover:bg-white/10 dark:hover:text-white";
      editBtn.innerHTML =
        '<svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.5 1.5l3 3-9 9H2.5v-3l9-9z" /></svg>';
      actionsRow.appendChild(editBtn);

      body.appendChild(actionsRow);

      article.appendChild(body);
      return article;
    }

    function recomputeSagaCounts() {
      sagaCounts.clear();
      for (const g of games) {
        if (g.saga) sagaCounts.set(g.saga, (sagaCounts.get(g.saga) ?? 0) + 1);
      }
    }

    function rebuildSagaOptions() {
      if (!sagaFilterSelect) return;
      const prev = currentSaga;
      const entries = [...sagaCounts.entries()].sort(
        (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
      );
      // Reconstruyo opciones con nodos DOM para que una saga editable no pueda
      // interpretarse como markup.
      sagaFilterSelect.replaceChildren();
      const allOption = document.createElement("option");
      allOption.value = "__all__";
      allOption.textContent = "Todas (" + games.length + ")";
      sagaFilterSelect.appendChild(allOption);
      for (const [s, n] of entries) {
        const option = document.createElement("option");
        option.value = s;
        option.textContent = s + " (" + n + ")";
        sagaFilterSelect.appendChild(option);
      }
      // Si la saga actual ya no existe (game eliminado), volver a "Todas".
      if (prev !== "__all__" && !sagaCounts.has(prev)) {
        currentSaga = "__all__";
      }
      sagaFilterSelect.value = currentSaga;
      // Mostrar/ocultar el grupo si no hay sagas.
      if (sagaFilterGroup) {
        sagaFilterGroup.classList.toggle("hidden", sagaCounts.size === 0);
      }
    }

    function renderCounts() {
      if (!filterGroup) return;
      const c = { backlog: 0, playing: 0, finished: 0 };
      for (const g of games) c[g.status]++;
      filterGroup.querySelectorAll("[data-filter-tab]").forEach((tab) => {
        const key = tab.dataset.filterTab;
        const count = key === "all" ? games.length : c[key] || 0;
        const label = key === "all" ? "Todas" : statusLabels[key] || key;
        tab.textContent = label + " (" + count + ")";
      });
    }

    function applyFilter() {
      const cards = grid ? Array.from(grid.querySelectorAll("[data-game-card]")) : [];
      let visible = 0;
      for (const card of cards) {
        const okStatus = currentFilter === "all" || card.dataset.status === currentFilter;
        const okSaga =
          currentSaga === "__all__" || (card.dataset.saga || "") === currentSaga;
        const qOk = !currentSearch || (card.dataset.search || "").includes(currentSearch);
        const show = okStatus && okSaga && qOk;
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      }
      if (filteredEmpty) {
        filteredEmpty.classList.toggle(
          "hidden",
          !((currentFilter !== "all" || currentSaga !== "__all__" || currentSearch) && games.length > 0 && visible === 0)
        );
      }
    }

    function syncVisibility() {
      const noGames = games.length === 0;
      if (grid) grid.classList.toggle("hidden", noGames);
      if (filterGroup) filterGroup.classList.toggle("hidden", noGames);
      if (sagaFilterGroup) sagaFilterGroup.classList.toggle("hidden", noGames || sagaCounts.size === 0);
      if (emptyState) emptyState.classList.toggle("hidden", !noGames);
    }

    function setActiveTab() {
      if (!filterGroup) return;
      filterGroup.querySelectorAll("[data-filter-tab]").forEach((t) => {
        const active = t.dataset.filterTab === currentFilter;
        t.setAttribute("aria-selected", active ? "true" : "false");
        for (const c of FILTER_ACTIVE) t.classList.toggle(c, active);
        for (const c of FILTER_INACTIVE) t.classList.toggle(c, !active);
      });
    }

    filterGroup?.addEventListener("click", (e) => {
      const tab = e.target.closest("[data-filter-tab]");
      if (!tab) return;
      currentFilter = tab.dataset.filterTab;
      setActiveTab();
      applyFilter();
    });

    sagaFilterSelect?.addEventListener("change", (e) => {
      currentSaga = e.target.value || "__all__";
      applyFilter();
      // Notificar al AddGameDialog si está abierto, para que filtre la búsqueda
      // de Steam por la saga activa.
      if (typeof window.__addGameDialogSetSaga === "function") {
        window.__addGameDialogSetSaga(currentSaga);
      }
    });

    // Buscador "Buscar..." — debounce 200ms, solo memoria
    const searchInput = document.querySelector('[data-search-input]');
    const searchClear = document.querySelector('[data-search-clear]');
    let searchTimer = null;
    function toggleClear(){ if(searchClear) searchClear.classList.toggle('hidden', !searchInput || !searchInput.value); }
    searchInput?.addEventListener('input', () => {
      if(searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => { currentSearch = (searchInput.value || '').trim().toLowerCase(); toggleClear(); applyFilter(); }, 200);
    });
    searchClear?.addEventListener('click', () => { if(searchInput){ searchInput.value=''; currentSearch=''; toggleClear(); applyFilter(); searchInput.focus(); } });

    // --- Status dropdown custom (patrón del perk dropdown de D2) ---
    // El <select> nativo abría el popup con estilos del OS (texto gris sobre
    // blanco en dark mode, y desalineado). Este dropdown es un singleton en
    // <body> con position:fixed y atomic reveal: las coordenadas se aplican
    // ANTES de quitar 'hidden' para que el navegador nunca lo vea con
    // position:static.

    let statusMenu = null;
    let statusMenuBtn = null;

    function ensureStatusMenu() {
      if (statusMenu) return statusMenu;
      statusMenu = document.createElement("div");
      statusMenu.dataset.statusMenu = "";
      statusMenu.className =
        "fixed z-[9999] hidden overflow-hidden rounded-lg border border-zinc-300 bg-white p-1 text-zinc-900 shadow-2xl ring-1 ring-black/5 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100";
      statusMenu.setAttribute("role", "listbox");
      document.body.appendChild(statusMenu);
      statusMenu.addEventListener("click", async (e) => {
        const opt = e.target.closest("[data-status-option]");
        if (!opt || opt.disabled) return;
        const id = opt.dataset.gameId;
        const status = opt.dataset.statusOption;
        opt.disabled = true;
        try {
          const res = await fetch("/games/api/set-status", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, status }),
          });
          if (!res.ok) throw new Error("set-status");
          const data = await res.json();
          const game = games.find((g) => g.id === id);
          if (game) game.status = data.game.status;
          const card = findCard(id);
          if (card) {
            card.dataset.status = data.game.status;
            const btn = card.querySelector("[data-status-button]");
            if (btn) {
              btn.dataset.status = data.game.status;
              const labelEl = btn.querySelector("[data-status-label]");
              if (labelEl) labelEl.textContent = statusLabels[data.game.status] || data.game.status;
            }
          }
          renderCounts();
          applyFilter();
          updateRandomPickState();
          closeStatusMenu();
        } catch {
          closeStatusMenu();
        }
      });
      return statusMenu;
    }

    function closeStatusMenu() {
      if (!statusMenu) return;
      statusMenu.classList.add("hidden");
      statusMenu.replaceChildren();
      if (statusMenuBtn) {
        statusMenuBtn.setAttribute("aria-expanded", "false");
        statusMenuBtn = null;
      }
    }

    function openStatusMenu(btn) {
      const menu = ensureStatusMenu();
      closeStatusMenu();
      statusMenuBtn = btn;
      btn.setAttribute("aria-expanded", "true");

      for (const key of statusKeys) {
        const opt = document.createElement("button");
        opt.type = "button";
        opt.dataset.statusOption = key;
        opt.dataset.gameId = btn.dataset.gameId;
        opt.setAttribute("role", "option");
        opt.setAttribute("aria-selected", key === btn.dataset.status ? "true" : "false");
        opt.className =
          "flex w-full cursor-pointer items-center justify-between gap-2 rounded-md px-2.5 py-1.5 text-left text-xs font-medium text-zinc-900 hover:bg-zinc-100 dark:text-zinc-100 dark:hover:bg-white/10";
        const label = document.createElement("span");
        label.textContent = statusLabels[key] || key;
        opt.appendChild(label);
        if (key === btn.dataset.status) {
          const check = document.createElement("span");
          check.className = "shrink-0 text-zinc-400 dark:text-zinc-500";
          check.textContent = "✓";
          opt.appendChild(check);
        }
        menu.appendChild(opt);
      }

      // Atomic reveal: posicionar antes de revelar.
      const rect = btn.getBoundingClientRect();
      const gap = 4;
      const menuH = statusKeys.length * 30 + 8;
      const spaceBelow = window.innerHeight - rect.bottom - gap - 8;
      const useAbove = spaceBelow < menuH && rect.top > spaceBelow;
      const width = Math.max(120, Math.min(rect.width, window.innerWidth - 16));
      const left = Math.max(8, Math.min(window.innerWidth - width - 8, rect.left));
      menu.style.width = width + "px";
      menu.style.left = left + "px";
      menu.style.top = useAbove ? Math.max(8, rect.top - gap - menuH) + "px" : rect.bottom + gap + "px";
      menu.classList.remove("hidden");
    }

    document.addEventListener("click", (e) => {
      if (!statusMenu || statusMenu.classList.contains("hidden")) return;
      if (statusMenu.contains(e.target)) return;
      if (e.target.closest("[data-status-button]")) return;
      closeStatusMenu();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeStatusMenu();
    });
    window.addEventListener("scroll", closeStatusMenu, true);
    window.addEventListener("resize", closeStatusMenu);

    grid?.addEventListener("click", async (e) => {
      const statusBtn = e.target.closest("[data-status-button]");
      if (statusBtn) {
        e.preventDefault();
        if (
          statusMenuBtn === statusBtn &&
          statusMenu &&
          !statusMenu.classList.contains("hidden")
        ) {
          closeStatusMenu();
        } else {
          openStatusMenu(statusBtn);
        }
        return;
      }
      const editBtn = e.target.closest("[data-edit-game]");
      if (editBtn) {
        e.preventDefault();
        if (typeof window.__openEditGameDialog === "function") {
          window.__openEditGameDialog(
            editBtn.dataset.gameId,
            editBtn.dataset.gameName,
            editBtn.dataset.gameYear,
            editBtn.dataset.gameCover,
            editBtn.dataset.gameSaga || ""
          );
        }
        return;
      }
      const removeBtn = e.target.closest("[data-remove-game]");
      if (!removeBtn) return;
      e.preventDefault();
      const id = removeBtn.dataset.gameId;
      const card = findCard(id);
      if (!card) return;
      card.style.transition = "opacity 0.2s";
      card.style.opacity = "0";
      try {
        const res = await fetch("/games/api/remove", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });
        if (!res.ok && res.status !== 204) throw new Error("remove");
      } catch {
        card.style.opacity = "";
        return;
      }
      setTimeout(() => {
        games = games.filter((g) => g.id !== id);
        if (selectedRandomGame?.id === id) closeRandomDialog();
        card.remove();
        recomputeSagaCounts();
        rebuildSagaOptions();
        renderCounts();
        syncVisibility();
        applyFilter();
        updateHeaderCount();
        updateRandomPickState();
      }, 200);
    });

    function updateHeaderCount() {
      const el = document.querySelector("[data-games-count]");
      if (!el) return;
      const n = games.length;
      el.textContent = n + (n === 1 ? " juego" : " juegos");
    }

    window.addEventListener("games:game-added", (e) => {
      const detail = e && e.detail;
      if (!detail || !detail.game) return;
      try {
        games.unshift(detail.game);
        const card = buildGameCard(detail.game);
        if (grid) {
          grid.prepend(card);
          grid.classList.remove("hidden");
        }
        if (emptyState) emptyState.classList.add("hidden");
        recomputeSagaCounts();
        rebuildSagaOptions();
        renderCounts();
        syncVisibility();
        applyFilter();
        updateHeaderCount();
        updateRandomPickState();
      } catch (err) {
        console.error("games:game-added handler failed", err);
      }
    });

    // Actualiza la card in-place con el game devuelto por /api/edit.
    // Recorre el array local, reemplaza la fila, y reemplaza los nodos que
    // cambiaron: nombre (h3), botón ✏️ (data attrs), cover (img o placeholder),
    // badge de año. Mantiene el status, el botón de remove y el listener del
    // status menu.
    window.addEventListener("games:game-updated", (e) => {
      const detail = e && e.detail;
      if (!detail || !detail.game) return;
      const updated = detail.game;
      try {
        const idx = games.findIndex((g) => g.id === updated.id);
        if (idx >= 0) games[idx] = updated;
        else games.unshift(updated);

        const oldCard = findCard(updated.id);
        if (!oldCard) return;
        const newCard = buildGameCard(updated);
        oldCard.replaceWith(newCard);
        // Si el filtro activo era un status/saga y la card sigue matcheando,
        // queda visible; si no, el applyFilter la oculta. No cambiamos los
        // filtros.
        recomputeSagaCounts();
        rebuildSagaOptions();
        applyFilter();
        updateRandomPickState();
      } catch (err) {
        console.error("games:game-updated handler failed", err);
      }
    });

    updateRandomPickState();
  </script>

  <AddGameDialog userSagas={userSagas} />
  <EditGameDialog userSagas={userSagas} />
</BaseLayout>
