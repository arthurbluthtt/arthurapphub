---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppGrid from '../components/AppGrid.astro';
import { getAllApps } from '../lib/apps';
import { listArchivedAppIds } from '../lib/app-archives';
import {
  COOKIE_NAME_CONST,
  SESSION_TTL_MS_CONST,
  createSession,
  getUserByUsername,
  hashPin,
  isValidPin,
  isValidUsername,
  lookupSession,
  normalizeUsername,
  readCookie,
  safeNextPath,
} from '../lib/auth';

export const prerender = false;

const next = safeNextPath(Astro.url.searchParams.get('next'));

const sessionId = readCookie(Astro.request);
const sess = sessionId ? await lookupSession(env.AUTH_DB, sessionId) : null;
const allApps = getAllApps();
const archivedIds = sess ? await listArchivedAppIds(env.AUTH_DB, sess.username) : new Set<string>();
const activeApps = allApps.filter((app) => !archivedIds.has(app.id));
const archivedApps = allApps.filter((app) => archivedIds.has(app.id));

let error: string | null = null;

if (!sess && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const usernameInput = String(form.get('username') ?? '');
  const pin = String(form.get('pin') ?? '').trim();
  const nextField = safeNextPath(form.get('next')?.toString() || next);

  const username = normalizeUsername(usernameInput);

  if (!usernameInput.trim() || !pin) {
    error = 'Completá usuario y PIN.';
  } else if (!isValidUsername(username)) {
    error = 'Usuario o PIN incorrecto.';
  } else if (!isValidPin(pin)) {
    error = 'Usuario o PIN incorrecto.';
  } else {
    const user = await getUserByUsername(env.AUTH_DB, username);
    if (!user) {
      error = 'Usuario o PIN incorrecto.';
    } else {
      const candidate = await hashPin(pin, username, env.AUTH_PEPPER);
      if (candidate !== user.pinHash) {
        error = 'Usuario o PIN incorrecto.';
      } else {
        const s = await createSession(env.AUTH_DB, username);
        Astro.cookies.set(COOKIE_NAME_CONST, s.sessionId, {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: Math.floor(SESSION_TTL_MS_CONST / 1000),
        });
        Astro.cookies.set('hub_user', username, {
          path: '/',
          secure: true,
          sameSite: 'lax',
          maxAge: Math.floor(SESSION_TTL_MS_CONST / 1000),
        });
        return Astro.redirect(nextField);
      }
    }
  }
}
---

<BaseLayout title={sess ? 'AppHub — Hub personal de apps' : 'Entrar — AppHub'} contentMaxWidth="max-w-6xl xl:max-w-[1760px] 2xl:max-w-[2240px]">
  {sess ? (
    <>
      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Mis apps</h1>
        <p class="mt-2 text-zinc-500 dark:text-zinc-500">Lanzador rápido a todas mis herramientas web.</p>
      </div>
      <section aria-labelledby="active-apps-heading">
        <h2 id="active-apps-heading" class="sr-only">Apps activas</h2>
        <AppGrid apps={activeApps} />
      </section>
      <section
        data-archived-apps-section
        aria-labelledby="archived-apps-heading"
        class={`mt-10 ${archivedApps.length ? '' : 'hidden'}`}
      >
        <div class="mb-4 flex items-center justify-between gap-4">
          <div>
            <h2 id="archived-apps-heading" class="text-xl font-semibold text-zinc-900 dark:text-white">
              <button
                type="button"
                data-archive-toggle
                aria-controls="archived-apps-grid"
                aria-expanded="true"
                class="inline-flex items-center gap-2 rounded-lg text-left outline-none transition hover:text-zinc-600 focus-visible:ring-2 focus-visible:ring-zinc-400 dark:hover:text-zinc-300"
              >
                <span>Apps archivadas <span data-archived-count class="text-sm font-normal text-zinc-500">({archivedApps.length})</span></span>
                <span data-archive-chevron aria-hidden="true" class="text-sm">⌃</span>
              </button>
            </h2>
            <p class="mt-1 text-sm text-zinc-500">Siguen disponibles, pero no aparecen en el lanzador principal.</p>
          </div>
        </div>
        <div id="archived-apps-grid" data-archived-apps-content>
          <AppGrid apps={archivedApps} archived />
        </div>
      </section>
      <p data-archive-status role="status" class="mt-6 min-h-5 text-sm text-red-600 dark:text-red-400" aria-live="polite"></p>
    </>
  ) : (
    <div class="mx-auto max-w-sm">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">Entrar</h1>
        <p class="mt-1 text-sm text-zinc-500">Usuario y PIN de 4 dígitos.</p>
        {
          error && (
            <p class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-600 dark:text-red-400">
              {error}
            </p>
          )
        }
        <form method="POST" class="mt-6 flex flex-col gap-3">
          <input type="hidden" name="next" value={next} />
          <input
            type="text"
            name="username"
            placeholder="arthur"
            autocomplete="username"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            required
            autofocus
            class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:focus:border-white/30"
          />
          <input
            type="password"
            name="pin"
            inputmode="numeric"
            autocomplete="current-password"
            pattern="[0-9]{4}"
            maxlength="4"
            minlength="4"
            required
            class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-3 text-center text-2xl tracking-[0.5em] text-zinc-900 outline-none focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:focus:border-white/30"
          />
          <button
            type="submit"
            class="w-full rounded-lg bg-zinc-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
          >
            Entrar
          </button>
        </form>
      </div>
      <p class="mt-4 text-center text-sm text-zinc-500">
        Primer acceso → <a
          href={`/signup${next && next !== '/' ? `?next=${encodeURIComponent(next)}` : ''}`}
          class="underline decoration-zinc-400 underline-offset-4 hover:text-zinc-900 dark:hover:text-white"
          >Crear usuario</a
        >
      </p>
    </div>
  )}
</BaseLayout>

{sess && (
  <script>
    const activeGrid = document.querySelector('[data-app-grid="active"]');
    const archivedSection = document.querySelector('[data-archived-apps-section]');
    const archivedContent = document.querySelector('[data-archived-apps-content]');
    const archivedGrid = document.querySelector('[data-app-grid="archived"]');
    const status = document.querySelector('[data-archive-status]');

    function updateArchivedSection() {
      if (!archivedSection || !archivedGrid) return;
      const activeCards = activeGrid?.querySelectorAll('[data-app-card]') ?? [];
      const archivedCards = archivedGrid.querySelectorAll('[data-app-card]');
      const count = archivedSection.querySelector('[data-archived-count]');
      if (count) count.textContent = `(${archivedCards.length})`;
      archivedSection.classList.toggle('hidden', archivedCards.length === 0);
      const archivedEmpty = archivedGrid.querySelector('[data-app-empty]');
      if (archivedEmpty) archivedEmpty.classList.toggle('hidden', archivedCards.length !== 0);
      const activeEmpty = activeGrid?.querySelector('[data-app-empty]');
      if (activeEmpty) activeEmpty.classList.toggle('hidden', activeCards.length !== 0);
    }

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const toggle = target.closest('[data-archive-toggle]');
      if (toggle instanceof HTMLButtonElement) {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        archivedContent?.classList.toggle('hidden', expanded);
        const chevron = toggle.querySelector('[data-archive-chevron]');
        if (chevron) chevron.textContent = expanded ? '⌄' : '⌃';
        return;
      }

      const button = target.closest('[data-app-archive-button]');
      if (!(button instanceof HTMLButtonElement) || button.disabled) return;

      const card = button.closest('[data-app-card]');
      const appId = button.dataset.appId;
      const appName = button.dataset.appName || appId;
      const wasArchived = button.dataset.archived === 'true';
      if (!card || !appId) return;

      button.disabled = true;
      if (status) status.textContent = '';
      try {
        const response = await fetch('/api/apps/archive', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ appId, archived: !wasArchived }),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload || payload.archived !== !wasArchived) {
          throw new Error(payload?.error || 'No se pudo actualizar la app.');
        }

        button.dataset.archived = String(payload.archived);
        button.textContent = payload.archived ? 'Restaurar' : 'Archivar';
        button.setAttribute('aria-label', `${payload.archived ? 'Restaurar' : 'Archivar'} ${appName}`);
        (payload.archived ? archivedGrid : activeGrid)?.append(card);
        updateArchivedSection();
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : 'No se pudo actualizar la app.';
      } finally {
        button.disabled = false;
      }
    });
  </script>
)}
