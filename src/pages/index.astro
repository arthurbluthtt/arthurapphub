---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppGrid from '../components/AppGrid.astro';
import { apps } from '../lib/apps';

export const prerender = true;
---

<BaseLayout title="AppHub — Hub personal de apps">
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
      Mis apps
    </h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">
      Lanzador rápido a todas mis herramientas web.
    </p>
  </div>
  <AppGrid apps={apps} />
</BaseLayout>
