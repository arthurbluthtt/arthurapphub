---
import { env } from 'cloudflare:workers';
import { lookupSession, readCookie, safeNextPath } from '../lib/auth';

export const prerender = false;

const sessionId = readCookie(Astro.request);
const sess = sessionId ? await lookupSession(env.AUTH_DB, sessionId) : null;

if (sess) {
  return Astro.redirect('/');
}

const next = safeNextPath(Astro.url.searchParams.get('next'));
return Astro.redirect(next !== '/' ? `/?next=${encodeURIComponent(next)}` : '/');
---
