---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COOKIE_NAME_CONST,
  SESSION_TTL_MS_CONST,
  createSession,
  createUser,
  hashPin,
  isValidPin,
  isValidUsername,
  lookupSession,
  normalizeUsername,
  readCookie,
  safeNextPath,
  usernameTaken,
} from '../lib/auth';

export const prerender = false;

const next = safeNextPath(Astro.url.searchParams.get('next'));

const sessionId = readCookie(Astro.request);
if (sessionId) {
  const sess = await lookupSession(env.AUTH_DB, sessionId);
  if (sess) {
    return Astro.redirect(next);
  }
}

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const usernameInput = String(form.get('username') ?? '');
  const pin = String(form.get('pin') ?? '').trim();

  const username = normalizeUsername(usernameInput);

  if (!usernameInput.trim() || !pin) {
    error = 'Completá usuario y PIN.';
  } else if (!isValidUsername(username)) {
    error = 'Usuario inválido: 3-20 caracteres, solo letras, números, guion o guion bajo.';
  } else if (!isValidPin(pin)) {
    error = 'El PIN debe ser exactamente 4 dígitos.';
  } else if (await usernameTaken(env.AUTH_DB, username)) {
    error = 'Ese nombre ya está en uso.';
  } else {
    const pinHash = await hashPin(pin, username, env.AUTH_PEPPER);
    try {
      await createUser(env.AUTH_DB, username, pinHash);
    } catch (e) {
      error = 'Ese nombre ya está en uso.';
    }
    if (!error) {
      const sess = await createSession(env.AUTH_DB, username);
      Astro.cookies.set(COOKIE_NAME_CONST, sess.sessionId, {
        path: '/',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: Math.floor(SESSION_TTL_MS_CONST / 1000),
      });
      Astro.cookies.set('hub_user', username, {
        path: '/',
        secure: true,
        sameSite: 'lax',
        maxAge: Math.floor(SESSION_TTL_MS_CONST / 1000),
      });
      return Astro.redirect(next);
    }
  }
}
---

<BaseLayout title="Crear usuario — AppHub">
  <div class="mx-auto max-w-sm">
    <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">Crear usuario</h1>
      <p class="mt-1 text-sm text-zinc-500">
        Elegí un nombre y un PIN de 4 dígitos. El PIN no se puede recuperar.
      </p>
      {
        error && (
          <p class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-600 dark:text-red-400">
            {error}
          </p>
        )
      }
      <form method="POST" class="mt-6 flex flex-col gap-3">
        <input
          type="text"
          name="username"
          placeholder="arthur"
          autocomplete="username"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          pattern="[a-z0-9_\-]{3,20}"
          minlength="3"
          maxlength="20"
          required
          autofocus
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-zinc-900 outline-none focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:focus:border-white/30"
        />
        <input
          type="password"
          name="pin"
          inputmode="numeric"
          autocomplete="new-password"
          pattern="[0-9]{4}"
          maxlength="4"
          minlength="4"
          required
          class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-3 text-center text-2xl tracking-[0.5em] text-zinc-900 outline-none focus:border-zinc-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:focus:border-white/30"
        />
        <button
          type="submit"
          class="w-full rounded-lg bg-zinc-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
        >
          Crear usuario y entrar
        </button>
      </form>
    </div>
    <p class="mt-4 text-center text-sm text-zinc-500">
      ¿Ya tenés usuario? <a
        href={`/login${next && next !== '/' ? `?next=${encodeURIComponent(next)}` : ''}`}
        class="underline decoration-zinc-400 underline-offset-4 hover:text-zinc-900 dark:hover:text-white"
        >Entrar</a
      >
    </p>
  </div>
</BaseLayout>
