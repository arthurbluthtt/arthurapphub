---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddCharacterDialog from '../../components/uma/AddCharacterDialog.astro';
import SupportCardList from '../../components/uma/SupportCardList.astro';
import SearchBar from '../../components/SearchBar.astro';
import { lookupSession, readCookie } from '../../lib/auth';
import { listWishlist } from '../../lib/uma/wishlist';
import { getRecommendations, getCharacter, cards } from '../../lib/uma/data';

export const prerender = false;

const sessionId = readCookie(Astro.request);
const sess = sessionId ? await lookupSession(env.AUTH_DB, sessionId) : null;
if (!sess) {
  return Astro.redirect('/?next=' + encodeURIComponent('/umamusume'));
}

const rows = await listWishlist(env.AUTH_DB, sess.username);
const foundCounts = rows.reduce(
  (acc, row) => {
    if (row.found) acc.found += 1;
    else acc.pending += 1;
    return acc;
  },
  { pending: 0, found: 0 }
);
const FILTER_TABS = ['all', 'pending', 'found'] as const;

// Hydrate cada row con el character + recommendations.
const cardByGame8Id = new Map(cards.map((c) => [c.game8Id, c]));
const resolveCards = (ids: string[]) =>
  ids.map((id) => cardByGame8Id.get(id)).filter((c): c is NonNullable<typeof c> => c != null);

const items = rows
  .map((row) => {
    const character = getCharacter(row.characterId);
    if (!character) return null;
    const recs = getRecommendations(row.characterId);
    const recsResolved = recs
      ? {
          scenario: recs.scenario,
          main: resolveCards(recs.main),
          budget: resolveCards(recs.budget),
          alternates: {
            speed: resolveCards(recs.alternates.speed),
            power: resolveCards(recs.alternates.power),
            wit: resolveCards(recs.alternates.wit),
          },
        }
      : null;
    return {
      row,
      character,
      recommendations: recsResolved,
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

const totalCount = items.length;

function iconUrl(type: 'character' | 'card', id: string): string {
  return `/umamusume/api/icon?type=${type}&id=${encodeURIComponent(id)}`;
}
---

<BaseLayout title="Uma Cards — AppHub" contentMaxWidth="max-w-[1760px] 2xl:max-w-[2240px]">
  <div class="mb-6 flex items-baseline justify-between gap-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl xl:text-5xl dark:text-white">
        Umamusume Cards
      </h1>
      <p class="mt-2 text-sm text-zinc-500 xl:text-base">
        Wishlist de personajes con las cartas de soporte más recomendadas (game8.co).
      </p>
    </div>
    <span class="text-xs uppercase tracking-wider text-zinc-500 xl:text-sm" data-characters-count>
      {totalCount} {totalCount === 1 ? 'personaje' : 'personajes'}
    </span>
  </div>

  <p
    class:list={[
      'rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500',
      totalCount > 0 && 'hidden',
    ]}
    data-empty-state
  >
    Tu wishlist está vacía. Buscá un personaje arriba y agregalo con un click.
  </p>

  <div class={totalCount === 0 ? 'hidden' : ''} data-search-container>
    <SearchBar placeholder="Buscar..." />
  </div>

  <div
    class:list={[
      'mb-4 flex flex-wrap gap-2',
      totalCount === 0 && 'hidden',
    ]}
    data-filter-group
    role="tablist"
    aria-label="Filtrar por estado"
  >
    {FILTER_TABS.map((filter) => (
      <button
        type="button"
        role="tab"
        aria-selected={filter === 'all'}
        data-filter-tab={filter}
        class:list={[
          'rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-wider transition',
          filter === 'all'
            ? 'border-zinc-900 bg-zinc-900 text-white dark:border-white dark:bg-white dark:text-zinc-900'
            : 'border-zinc-200 text-zinc-500 hover:border-zinc-400 hover:text-zinc-900 dark:border-white/10 dark:text-zinc-500 dark:hover:border-white/30 dark:hover:text-white',
        ]}
      >
        {filter === 'all'
          ? `Todas (${totalCount})`
          : filter === 'pending'
            ? `Pendientes (${foundCounts.pending})`
            : `Encontradas (${foundCounts.found})`}
      </button>
    ))}
  </div>

  <div
    class:list={[
      'grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-4',
      totalCount === 0 && 'hidden',
    ]}
    data-characters-grid
  >
    {items.map((item) => (
      <article
        data-character-card
        data-character-id={item.character.id}
        data-found={item.row.found ? '1' : '0'}
        data-recommendations={item.recommendations ? '1' : '0'}
        data-search={(item.character.name + ' ' + (item.character.version || '')).toLowerCase()}
        class="group relative flex flex-col gap-3 rounded-2xl border border-zinc-200 bg-white p-5 transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur"
      >
        <div class="flex items-center gap-4">
          <div class="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-zinc-100 dark:bg-white/[0.04]">
            <img
              src={iconUrl('character', item.character.id)}
              alt={item.character.name}
              loading="lazy"
              class="h-20 w-20 object-contain"
              style="image-rendering: -webkit-optimize-contrast;"
            />
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-zinc-900 dark:text-white">
              {item.character.name}
            </h3>
            {item.character.version && (
              <p class="text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
                {item.character.version}
              </p>
            )}
            {item.character.aptitudes && (
              <div class="mt-1 flex flex-wrap gap-x-2 gap-y-0.5 text-[10px] text-zinc-500 dark:text-zinc-400">
                <span>Surface: {item.character.aptitudes.surface.join(' / ') || '—'}</span>
                <span>Distance: {item.character.aptitudes.distance.join(' / ') || '—'}</span>
                <span>Pace: {item.character.aptitudes.pace.join(' / ') || '—'}</span>
              </div>
            )}
          </div>
          <button
            type="button"
            data-remove-character
            data-character-id={item.character.id}
            title="Quitar de la wishlist"
            aria-label="Quitar"
            class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-red-500/10 dark:hover:text-red-400"
          >
            ×
          </button>
        </div>

        {
          item.recommendations ? (
            <>
              <p class="text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
                Main build ({item.recommendations.scenario.replace('_', ' ')})
              </p>
              <SupportCardList cards={item.recommendations.main} />
              <button
                type="button"
                class="mt-1 self-start text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white"
                data-toggle-expand
                aria-expanded="false"
              >
                Ver más
              </button>
              <div
                class="hidden flex-col gap-3 border-t border-zinc-200 pt-3 dark:border-white/10"
                data-expand-content
              >
                {item.recommendations.budget.length > 0 && (
                  <div class="flex flex-col gap-1.5">
                    <p class="text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
                      Budget build
                    </p>
                    <SupportCardList cards={item.recommendations.budget} />
                  </div>
                )}
                {(item.recommendations.alternates.speed.length > 0 ||
                  item.recommendations.alternates.power.length > 0 ||
                  item.recommendations.alternates.wit.length > 0) && (
                  <div class="flex flex-col gap-2">
                    <p class="text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500">
                      Alternates
                    </p>
                    {item.recommendations.alternates.speed.length > 0 && (
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-[10px] uppercase tracking-wider text-zinc-500 dark:text-zinc-500">Spd</span>
                        <SupportCardList cards={item.recommendations.alternates.speed} size="xs" />
                      </div>
                    )}
                    {item.recommendations.alternates.power.length > 0 && (
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-[10px] uppercase tracking-wider text-zinc-500 dark:text-zinc-500">Pow</span>
                        <SupportCardList cards={item.recommendations.alternates.power} size="xs" />
                      </div>
                    )}
                    {item.recommendations.alternates.wit.length > 0 && (
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-[10px] uppercase tracking-wider text-zinc-500 dark:text-zinc-500">Wit</span>
                        <SupportCardList cards={item.recommendations.alternates.wit} size="xs" />
                      </div>
                    )}
                  </div>
                )}
              </div>
            </>
          ) : (
            <p class="text-[10px] uppercase tracking-wider text-zinc-500">
              Sin recomendaciones (refresh pendiente)
            </p>
          )
        }
        <div class="flex items-center justify-between gap-2 border-t border-zinc-200 pt-2 dark:border-white/10">
          <button
            type="button"
            data-toggle-found
            data-character-id={item.character.id}
            data-found={item.row.found ? '1' : '0'}
            class="text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white"
          >
            {item.row.found ? 'Marcar pendiente' : 'Marcar encontrada'}
          </button>
          <span data-found-label class="text-[10px] uppercase tracking-wider text-zinc-400 dark:text-zinc-600">
            {item.row.found ? 'Encontrada' : 'Pendiente'}
          </span>
        </div>
      </article>
    ))}
  </div>

  <p
    class="hidden rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/10 dark:text-zinc-500"
    data-filtered-empty
  >
    No tenés personajes con ese estado o búsqueda.
  </p>

  <script is:inline define:vars={{ emptyDataUrl: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="%23e4e4e7"/><text x="50%" y="58%" font-size="28" text-anchor="middle" fill="%2371717a" font-family="sans-serif">?</text></svg>' }}>
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[c]);
    }

    // Contador de personajes en el header. Se actualiza tras add/remove in-place.
    let characterCount = 0;
    function updateHeaderCount() {
      const el = document.querySelector('[data-characters-count]');
      if (!el) return;
      const n = characterCount;
      el.textContent = n + (n === 1 ? ' personaje' : ' personajes');
    }

    const grid = document.querySelector('[data-characters-grid]');
    const filterGroup = document.querySelector('[data-filter-group]');
    const filteredEmpty = document.querySelector('[data-filtered-empty]');
    const searchContainer = document.querySelector('[data-search-container]');
    const FILTER_ACTIVE = [
      'border-zinc-900',
      'bg-zinc-900',
      'text-white',
      'dark:border-white',
      'dark:bg-white',
      'dark:text-zinc-900',
    ];
    const FILTER_INACTIVE = [
      'border-zinc-200',
      'text-zinc-500',
      'hover:border-zinc-400',
      'hover:text-zinc-900',
      'dark:border-white/10',
      'dark:text-zinc-500',
      'dark:hover:border-white/30',
      'dark:hover:text-white',
    ];
    let currentFilter = 'all';

    function syncVisibility() {
      const noItems = characterCount === 0;
      const empty = document.querySelector('[data-empty-state]');
      if (grid) grid.classList.toggle('hidden', noItems);
      if (filterGroup) filterGroup.classList.toggle('hidden', noItems);
      if (searchContainer) searchContainer.classList.toggle('hidden', noItems);
      if (empty) empty.classList.toggle('hidden', !noItems);
    }

    // Inicializar contador con los articles renderizados server-side.
    characterCount = document.querySelectorAll('[data-character-card]').length;

    function renderCounts() {
      if (!filterGroup) return;
      const counts = { pending: 0, found: 0 };
      document.querySelectorAll('[data-character-card]').forEach((card) => {
        if (card.dataset.found === '1') counts.found += 1;
        else counts.pending += 1;
      });
      filterGroup.querySelectorAll('[data-filter-tab]').forEach((tab) => {
        const key = tab.dataset.filterTab;
        const label = key === 'all' ? 'Todas' : key === 'found' ? 'Encontradas' : 'Pendientes';
        const count = key === 'all' ? characterCount : counts[key] || 0;
        tab.textContent = label + ' (' + count + ')';
      });
    }

    function setActiveFilter() {
      filterGroup?.querySelectorAll('[data-filter-tab]').forEach((tab) => {
        const active = tab.dataset.filterTab === currentFilter;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        for (const cls of FILTER_ACTIVE) tab.classList.toggle(cls, active);
        for (const cls of FILTER_INACTIVE) tab.classList.toggle(cls, !active);
      });
    }

    function applyFilters() {
      const cards = grid ? Array.from(grid.querySelectorAll('[data-character-card]')) : [];
      let visible = 0;
      for (const card of cards) {
        const statusOk = currentFilter === 'all' ||
          (currentFilter === 'found' ? card.dataset.found === '1' : card.dataset.found !== '1');
        const searchOk = !currentSearch || (card.dataset.search || '').includes(currentSearch);
        const show = statusOk && searchOk;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }
      if (filteredEmpty) {
        filteredEmpty.classList.toggle(
          'hidden',
          !((currentFilter !== 'all' || currentSearch) && characterCount > 0 && visible === 0)
        );
      }
    }

    renderCounts();
    setActiveFilter();

    // Buscador local "Buscar..." — solo nombre/versión, debounce 200ms
    let currentSearch = "";
    const searchInput = document.querySelector('[data-search-input]');
    const searchClear = document.querySelector('[data-search-clear]');
    function toggleClear(){ if(searchClear) searchClear.classList.toggle('hidden', !searchInput || !searchInput.value); }
    let searchTimer = null;
    searchInput?.addEventListener('input', () => {
      if(searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => { currentSearch = (searchInput.value || '').trim().toLowerCase(); toggleClear(); applyFilters(); }, 200);
    });
    searchClear?.addEventListener('click', () => { if(searchInput){ searchInput.value=''; currentSearch=''; toggleClear(); applyFilters(); searchInput.focus(); } });

    filterGroup?.addEventListener('click', (e) => {
      const tab = e.target.closest('[data-filter-tab]');
      if (!tab) return;
      currentFilter = tab.dataset.filterTab || 'all';
      setActiveFilter();
      applyFilters();
    });

    document.querySelector('[data-characters-grid]')?.addEventListener('click', async (e) => {
      const removeBtn = e.target.closest('[data-remove-character]');
      const expandBtn = e.target.closest('[data-toggle-expand]');
      const toggleFoundBtn = e.target.closest('[data-toggle-found]');

      if (expandBtn) {
        e.preventDefault();
        const card = expandBtn.closest('[data-character-card]');
        const content = card?.querySelector('[data-expand-content]');
        if (!content) return;
        const expanded = expandBtn.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          content.classList.add('hidden');
          content.classList.remove('flex');
          expandBtn.setAttribute('aria-expanded', 'false');
          expandBtn.textContent = 'Ver más';
        } else {
          content.classList.remove('hidden');
          content.classList.add('flex');
          expandBtn.setAttribute('aria-expanded', 'true');
          expandBtn.textContent = 'Ver menos';
        }
        return;
      }

      if (toggleFoundBtn) {
        e.preventDefault();
        const card = toggleFoundBtn.closest('[data-character-card]');
        const characterId = toggleFoundBtn.dataset.characterId;
        if (!card || !characterId) return;
        toggleFoundBtn.disabled = true;
        try {
          const res = await fetch('/umamusume/api/toggle-found', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ characterId }),
          });
          if (!res.ok) throw new Error('toggle-found');
          const data = await res.json();
          if (typeof data.found !== 'boolean') throw new Error('toggle-found-payload');
          const found = data.found;
          card.dataset.found = found ? '1' : '0';
          toggleFoundBtn.dataset.found = found ? '1' : '0';
          toggleFoundBtn.textContent = found ? 'Marcar pendiente' : 'Marcar encontrada';
          const label = card.querySelector('[data-found-label]');
          if (label) label.textContent = found ? 'Encontrada' : 'Pendiente';
          renderCounts();
          applyFilters();
        } catch {
          // Mantener la card sin cambios si el servidor no pudo actualizarla.
        } finally {
          toggleFoundBtn.disabled = false;
        }
        return;
      }

      if (removeBtn) {
        e.preventDefault();
        const card = removeBtn.closest('[data-character-card]');
        const characterId = removeBtn.dataset.characterId;
        if (!card || !characterId) return;
        card.style.transition = 'opacity 0.2s';
        card.style.opacity = '0';
        try {
          const res = await fetch('/umamusume/api/remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ characterId }),
          });
          if (!res.ok && res.status !== 204) throw new Error('remove');
        } catch {
          card.style.opacity = '';
          return;
        }
        setTimeout(() => {
          try {
            card.remove();
            characterCount = Math.max(0, characterCount - 1);
            updateHeaderCount();
            renderCounts();
            syncVisibility();
            applyFilters();
          } catch (err) {
            console.error('remove handler post-fetch failed', err);
          }
        }, 200);
      }
    });

    // Construye el DOM de un card de personaje sin usar innerHTML — evita
    // cualquier problema de rendering cuando el nombre contiene caracteres
    // especiales (apostrofes, comillas, <, >, &).
    function buildCharacterArticle(character, recs) {
      const article = document.createElement('article');
      article.dataset.characterCard = '';
      article.dataset.characterId = character.id;
      article.dataset.found = '0';
      article.dataset.recommendations = recs ? '1' : '0';
      article.dataset.search = ((character.name || '') + ' ' + (character.version || '')).toLowerCase();
      article.className =
        'group relative flex flex-col gap-3 rounded-2xl border border-zinc-200 bg-white p-5 transition dark:border-white/10 dark:bg-white/[0.025] dark:backdrop-blur';

      // Header: icono + nombre + botón eliminar.
      const header = document.createElement('div');
      header.className = 'flex items-center gap-4';

      const iconWrap = document.createElement('div');
      iconWrap.className =
        'flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-zinc-100 dark:bg-white/[0.04]';
      const charIcon = document.createElement('img');
      charIcon.src = '/umamusume/api/icon?type=character&id=' + encodeURIComponent(character.id);
      charIcon.alt = character.name || '';
      charIcon.loading = 'lazy';
      charIcon.className = 'h-20 w-20 object-contain';
      charIcon.style.imageRendering = '-webkit-optimize-contrast';
      charIcon.onerror = () => {
        charIcon.onerror = null;
        charIcon.src = emptyDataUrl;
      };
      iconWrap.appendChild(charIcon);
      header.appendChild(iconWrap);

      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';
      const nameEl = document.createElement('h3');
      nameEl.className = 'font-semibold text-zinc-900 dark:text-white';
      nameEl.textContent = character.name || '';
      info.appendChild(nameEl);
      if (character.version) {
        const verEl = document.createElement('p');
        verEl.className =
          'text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500';
        verEl.textContent = character.version;
        info.appendChild(verEl);
      }
      if (character.aptitudes) {
        const aptitudesEl = document.createElement('div');
        aptitudesEl.className = 'mt-1 flex flex-wrap gap-x-2 gap-y-0.5 text-[10px] text-zinc-500 dark:text-zinc-400';
        for (const [label, values] of [
          ['Surface', character.aptitudes.surface],
          ['Distance', character.aptitudes.distance],
          ['Pace', character.aptitudes.pace],
        ]) {
          const valueEl = document.createElement('span');
          valueEl.textContent = label + ': ' + (values?.join(' / ') || '—');
          aptitudesEl.appendChild(valueEl);
        }
        info.appendChild(aptitudesEl);
      }
      header.appendChild(info);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.dataset.removeCharacter = '';
      removeBtn.dataset.characterId = character.id;
      removeBtn.title = 'Quitar de la wishlist';
      removeBtn.ariaLabel = 'Quitar';
      removeBtn.className =
        'grid h-7 w-7 shrink-0 place-items-center rounded-full text-zinc-400 transition hover:bg-red-500/10 hover:text-red-500 dark:text-zinc-500 dark:hover:bg-red-500/10 dark:hover:text-red-400';
      removeBtn.textContent = '×';
      header.appendChild(removeBtn);

      article.appendChild(header);

      // Main build: label + lista de iconos.
      if (recs) {
        const label = document.createElement('p');
        label.className =
          'text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500';
        label.textContent = 'Main build (' + (recs.scenario || '').replace(/_/g, ' ') + ')';
        article.appendChild(label);

        const iconsWrap = document.createElement('div');
        iconsWrap.className = 'flex flex-wrap gap-2';
        for (const c of recs.main.slice(0, 6)) {
          const cardIcon = document.createElement('img');
          cardIcon.src = '/umamusume/api/icon?type=card&id=' + encodeURIComponent(c.game8Id);
          cardIcon.alt = c.name || '';
          cardIcon.title = c.name || '';
          cardIcon.loading = 'lazy';
          cardIcon.className =
            'w-16 aspect-[50/66] object-cover shrink-0 rounded ring-1 ring-zinc-200 dark:ring-white/10 bg-zinc-50 dark:bg-white/[0.04]';
          cardIcon.onerror = () => {
            cardIcon.onerror = null;
            cardIcon.src = emptyDataUrl;
          };
          iconsWrap.appendChild(cardIcon);
        }
        article.appendChild(iconsWrap);

        // Botón Ver más + contenido expandible.
        const expandBtn = document.createElement('button');
        expandBtn.type = 'button';
        expandBtn.dataset.toggleExpand = '';
        expandBtn.setAttribute('aria-expanded', 'false');
        expandBtn.className =
          'mt-1 self-start text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white';
        expandBtn.textContent = 'Ver más';
        article.appendChild(expandBtn);

        const expandContent = document.createElement('div');
        expandContent.className =
          'hidden flex-col gap-3 border-t border-zinc-200 pt-3 dark:border-white/10';
        expandContent.dataset.expandContent = '';

        if (recs.budget && recs.budget.length > 0) {
          const budgetWrap = document.createElement('div');
          budgetWrap.className = 'flex flex-col gap-1.5';
          const bl = document.createElement('p');
          bl.className =
            'text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500';
          bl.textContent = 'Budget build';
          budgetWrap.appendChild(bl);
          const bi = document.createElement('div');
          bi.className = 'flex flex-wrap gap-2';
          for (const c of recs.budget) {
            const ci = document.createElement('img');
            ci.src = '/umamusume/api/icon?type=card&id=' + encodeURIComponent(c.game8Id);
            ci.alt = c.name || '';
            ci.title = c.name || '';
            ci.loading = 'lazy';
            ci.className =
              'w-16 aspect-[50/66] object-cover shrink-0 rounded ring-1 ring-zinc-200 dark:ring-white/10 bg-zinc-50 dark:bg-white/[0.04]';
            ci.onerror = () => {
              ci.onerror = null;
              ci.src = emptyDataUrl;
            };
            bi.appendChild(ci);
          }
          budgetWrap.appendChild(bi);
          expandContent.appendChild(budgetWrap);
        }

        const alternateGroups = [
          ['speed', 'Spd'],
          ['power', 'Pow'],
          ['wit', 'Wit'],
        ];
        const hasAlternates = alternateGroups.some(([key]) =>
          (recs.alternates?.[key] || []).length > 0
        );
        if (hasAlternates) {
          const alternatesWrap = document.createElement('div');
          alternatesWrap.className = 'flex flex-col gap-2';
          const alternatesLabel = document.createElement('p');
          alternatesLabel.className =
            'text-[10px] font-medium uppercase tracking-wider text-zinc-500 dark:text-zinc-500';
          alternatesLabel.textContent = 'Alternates';
          alternatesWrap.appendChild(alternatesLabel);

          for (const [key, label] of alternateGroups) {
            const alternateCards = recs.alternates?.[key] || [];
            if (!alternateCards.length) continue;
            const row = document.createElement('div');
            row.className = 'flex flex-wrap items-center gap-2';
            const categoryLabel = document.createElement('span');
            categoryLabel.className = 'text-[10px] uppercase tracking-wider text-zinc-500 dark:text-zinc-500';
            categoryLabel.textContent = label;
            row.appendChild(categoryLabel);
            const cardsWrap = document.createElement('div');
            cardsWrap.className = 'flex flex-wrap gap-2';
            for (const c of alternateCards) {
              const cardIcon = document.createElement('img');
              cardIcon.src = '/umamusume/api/icon?type=card&id=' + encodeURIComponent(c.game8Id);
              cardIcon.alt = c.name || '';
              cardIcon.title = c.name || '';
              cardIcon.loading = 'lazy';
              cardIcon.className =
                'w-12 aspect-[50/66] object-cover shrink-0 rounded ring-1 ring-zinc-200 dark:ring-white/10 bg-zinc-50 dark:bg-white/[0.04]';
              cardIcon.onerror = () => {
                cardIcon.onerror = null;
                cardIcon.src = emptyDataUrl;
              };
              cardsWrap.appendChild(cardIcon);
            }
            row.appendChild(cardsWrap);
            alternatesWrap.appendChild(row);
          }
          expandContent.appendChild(alternatesWrap);
        }
        article.appendChild(expandContent);
      } else {
        const empty = document.createElement('p');
        empty.className = 'text-[10px] uppercase tracking-wider text-zinc-500';
        empty.textContent = 'Sin recomendaciones (refresh pendiente)';
        article.appendChild(empty);
      }

      const statusRow = document.createElement('div');
      statusRow.className = 'flex items-center justify-between gap-2 border-t border-zinc-200 pt-2 dark:border-white/10';
      const toggleFoundBtn = document.createElement('button');
      toggleFoundBtn.type = 'button';
      toggleFoundBtn.dataset.toggleFound = '';
      toggleFoundBtn.dataset.characterId = character.id;
      toggleFoundBtn.dataset.found = '0';
      toggleFoundBtn.className = 'text-xs uppercase tracking-wider text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white';
      toggleFoundBtn.textContent = 'Marcar encontrada';
      statusRow.appendChild(toggleFoundBtn);
      const statusLabel = document.createElement('span');
      statusLabel.dataset.foundLabel = '';
      statusLabel.className = 'text-[10px] uppercase tracking-wider text-zinc-400 dark:text-zinc-600';
      statusLabel.textContent = 'Pendiente';
      statusRow.appendChild(statusLabel);
      article.appendChild(statusRow);
      return article;
    }

    window.addEventListener('umamusume:character-added', async (e) => {
      const detail = e && e.detail;
      if (!detail || !detail.characterId) return;
      try {
        const res = await fetch('/umamusume/api/character/' + encodeURIComponent(detail.characterId));
        if (!res.ok) {
          window.location.reload();
          return;
        }
        const data = await res.json();
        const article = buildCharacterArticle(data.character, data.recommendations);
        const grid = document.querySelector('[data-characters-grid]');
        if (grid) {
          grid.prepend(article);
          grid.classList.remove('hidden');
        }
        characterCount += 1;
        updateHeaderCount();
        renderCounts();
        syncVisibility();
        applyFilters();
      } catch (err) {
        console.error('umamusume:character-added handler failed', err);
        window.location.reload();
      }
    });
  </script>

  <AddCharacterDialog />
</BaseLayout>
